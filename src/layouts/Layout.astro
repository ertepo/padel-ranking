            <a
              href="mailto:tiebreakpoggio@gmail.com"
              class="underline hover:text-black"
            >
              tiebreakpoggio@gmail.com
            </a>
          </li>

          <li>
            Instagram:
            <a
              href="https://instagram.com/tiebreak.poggiosanvicino"
              target="_blank"
              class="underline hover:text-black"
            >
              @tiebreak.poggiosanvicino
            </a>
          </li>
        </ul>
      </div>


    </div>

    <div class="mt-10 pt-6 border-t-2 border-black text-xs font-bold text-slate-500 flex flex-col md:flex-row gap-2 md:justify-between">
      <span>
        © 2026 TIE-BREAK - Poggio San Vicino. All rights reserved.
      </span>

      <span>
        Built with Astro + Supabase
