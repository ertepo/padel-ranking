          </div>

        </div>
      </div>
      <!-- Contatti -->
      <div>
        <h3 class="text-lg font-black uppercase mb-3">
          Contatti
        </h3>

        <ul class="space-y-2 text-sm font-bold text-slate-700">
          <li>
            Telefono:
            <a
              href="tel:+3382437113"
              class="underline hover:text-black"
            >
              +338 243 7113
            </a>
          </li>
