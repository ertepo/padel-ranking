---
import '../styles/global.css';

const { title = 'Padel Ranking' } = Astro.props;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body>
    <header class="bg-[var(--giallo-club)] border-b-4 border-black">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/classifica" class="text-2xl font-black tracking-tight text-black">
          POGGIO'S<br class="sm:hidden" /> CHAMPIONSHIP
        </a>

        <nav class="flex gap-3 text-sm sm:text-base">
          <a href="/classifica" class="club-btn px-3 py-2">Classifica</a>
          <a href="/matches" class="club-btn px-3 py-2">Match</a>
          <a href="/admin" class="club-btn px-3 py-2">Admin</a>
        </nav>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>
  </body>
</html>