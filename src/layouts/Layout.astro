---
import '../styles/global.css';
import Header from '../components/Header.svelte';

const { title = 'Padel Ranking' } = Astro.props;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body>
    <Header client:load />

    <main class="max-w-5xl mx-auto px-4 py-8">
      <slot />
    </main>
  </body>
  <footer class="mt-20 border-t-4 border-black bg-white">
  <div class="max-w-6xl mx-auto px-4 py-10">

    <div class="grid gap-10 md:grid-cols-3">

      <!-- Brand -->
      <div>
        <h2 class="text-2xl font-black uppercase text-black">
          TIE-BREAK
        </h2>
        <h3 class="text-lg font-bold uppercase text-slate-700">
          Poggio San Vicino
        </h3>
        <p class="mt-3 text-sm font-medium text-slate-600 leading-relaxed">
          Ranking Tennis & Padel con classifiche live,
          statistiche giocatori e storico match.
        </p>
      </div>

      <!-- Sponsor -->
      <div>
        <h3 class="text-lg font-black uppercase mb-3">
          Sponsor Ufficiali
