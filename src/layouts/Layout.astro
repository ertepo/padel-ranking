---
import '../styles/global.css';

const { title = 'Padel Ranking' } = Astro.props;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>
  </head>

  <body class="bg-zinc-950 text-white min-h-screen">
    <header
      class="border-b border-zinc-800"
    >
      <div
        class="max-w-5xl mx-auto px-4 py-4 flex gap-6"
      >
        <a
          href="/classifica"
          class="text-green-400 font-semibold"
        >
          Classifica
        </a>

        <a
          href="/matches"
          class="text-zinc-300"
        >
          Match
        </a>

        <a
          href="/admin"
          class="text-zinc-300"
        >
          Admin
        </a>
      </div>
    </header>

    <main
      class="max-w-5xl mx-auto px-4 py-8"
    >
      <slot />
    </main>
  </body>
</html>