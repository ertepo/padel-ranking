---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import MatchesList from '../components/MatchesList.svelte';

// =========================
// PADEL MATCHES
// =========================

const padelMatchesQuery = supabase
  .from('matches')
  .select(`
    id,
    created_at,
    winner_team,
    score,
    team_a_avg_elo,
    team_b_avg_elo,
    match_type,
    match_players (
      id,
      player_id,
      team,
      result,
      delta,
      players (
        name
      )
    )
  `)
  .order('created_at', { ascending: false })
  .range(0, 49);

// =========================
// TENNIS MATCHES
// =========================

const tennisMatchesQuery = supabase
  .from('tennis_matches')
  .select(`
    id,
    created_at,
    score,
    challenger_id,
    defender_id,
    winner_id,
    challenger_old_position,
    challenger_new_position,
    defender_old_position,
    defender_new_position,
    challenger:players!tennis_matches_challenger_id_fkey (
      id,
      name
    ),
    defender:players!tennis_matches_defender_id_fkey (
      id,
      name
    ),
    winner:players!tennis_matches_winner_id_fkey (
      id,
      name
    )
  `)
  .order('created_at', { ascending: false })
  .range(0, 49);

// =========================
// PLAYERS
// =========================

const playersQuery = supabase
  .from('players')
  .select('id, name')
  .eq('active', true)
  .order('name');

// =========================
// FETCH PARALLELO
// =========================

const [
  padelResponse,
  tennisResponse,
  playersResponse
] = await Promise.all([
  padelMatchesQuery,
  tennisMatchesQuery,
  playersQuery
]);

// =========================
// FORMATTA MATCH TENNIS
// =========================

const tennisMatchesFormatted =
  (tennisResponse.data || []).map(match => {

    const challengerWon =
      match.winner_id === match.challenger_id;

    return {
      id: `tennis-${match.id}`,
      created_at: match.created_at,
      score: match.score,

      tennisData: {
        challenger: match.challenger,
        defender: match.defender,
        winner: match.winner,
        challenger_old_position:
          match.challenger_old_position,
        challenger_new_position:
          match.challenger_new_position,
        defender_old_position:
          match.defender_old_position,
        defender_new_position:
          match.defender_new_position,
        challengerWon
      }
    };
  });

// =========================
// MATCHES FINALI
// =========================

const combinedMatches = [
  ...(padelResponse.data || []),

  ...tennisMatchesFormatted
];

// Ordine globale
combinedMatches.sort((a, b) => {
  return (
    new Date(b.created_at).getTime() -
    new Date(a.created_at).getTime()
  );
});

const error =
  padelResponse.error ||
  tennisResponse.error;

const players =
  playersResponse.data || [];
---

<Layout
  title="Storico Matches"
  description="Consulta lo storico dei match di tennis e padel del circolo Tie-Break Poggio San Vicino, con risultati, giocatori e aggiornamenti delle classifiche."
>
  <section class="mb-8">
    <p class="text-sm uppercase tracking-widest font-black text-slate-600">
      Storico
    </p>
    <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
      Matches
    </h1>
  </section>

  {error && (
    <pre class="club-card p-4 text-red-600 mb-6">
      {JSON.stringify(error, null, 2)}
    </pre>
  )}

  {/* Usiamo client:load o client:visible. Passiamo i dati iniziali a Svelte */}
  <MatchesList
  initialMatches={combinedMatches}
  players={players}
  client:load
/>
</Layout>
