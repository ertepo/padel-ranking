---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import MatchesList from '../components/MatchesList.svelte';

// Carichiamo i dati iniziali in parallelo lato server
const [matchesResponse, playersResponse] = await Promise.all([
  supabase
    .from('matches')
    .select(`
      id,
      created_at,
      winner_team,
      score,
      team_a_avg_elo,
      team_b_avg_elo,
      match_type,
      match_players (
        id,
        player_id,
        team,
        result,
        delta,
        players (
          name
        )
      )
    `)
    .order('created_at', { ascending: false })
    .range(0, 9), // Carica i primi 10 per testare subito se va, poi puoi mettere 25 o 50

  supabase
    .from('players')
    .select('id, name')
    .eq('active', true)
    .order('name')
]);

const initialMatches = matchesResponse.data ?? [];
const error = matchesResponse.error;
const players = playersResponse.data ?? [];
---

<Layout title="Match">
  <section class="mb-8">
    <p class="text-sm uppercase tracking-widest font-black text-slate-600">
      Storico
    </p>
    <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
      Match
    </h1>
  </section>

  {error && (
    <pre class="club-card p-4 text-red-600 mb-6">
      {JSON.stringify(error, null, 2)}
    </pre>
  )}

  {/* Usiamo client:load o client:visible. Passiamo i dati iniziali a Svelte */}
  <MatchesList
    initialMatches={initialMatches}
    players={players}
    client:load
  />
</Layout>