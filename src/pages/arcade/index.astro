---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Arcade"
  headerTheme="club"
  description="I mini-giochi arcade di Tie-Break: Legends Game, Quindici, Slice e Trivia. Scegli un gioco e mettiti alla prova, ogni partita entra in classifica."
>
  <section class="mb-10">
    <p class="text-sm uppercase tracking-widest font-black text-slate-600">Tennis</p>
    <h1 class="text-5xl md:text-7xl font-black leading-none text-black">Arcade</h1>
    <p class="mt-5 max-w-3xl text-lg font-semibold leading-relaxed text-slate-700">
      Scegli un gioco e mettiti alla prova: ogni partita entra in classifica con il tuo nickname.
    </p>
  </section>

  <div class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
    <a
      href="/arcade/chilhavinto"
      class="dark-club-card dark-club-card-yellow relative flex flex-col items-center gap-2 bg-white p-3 text-center transition md:items-stretch md:gap-0 md:p-5 md:text-left"
    >
      <div class="order-1 w-full md:order-2">
        <p class="hidden text-xs uppercase tracking-widest font-black text-slate-500 md:block">Gioco 01</p>
        <h2 class="text-base font-black leading-tight text-black highlight-yellow md:mt-3 md:text-3xl md:leading-none">Chi l'ha vinto?</h2>
        <span class="mt-5 hidden justify-center md:flex">
          <span class="club-btn-yellow inline-block px-4 py-2">Gioca</span>
        </span>
      </div>

      <img
        src="/images/chilhavinto.svg"
        alt="Chi l'ha vinto?"
        loading="lazy"
        class="order-2 aspect-[16/9] w-full border-2 border-black bg-white object-contain p-2 md:order-1 md:mb-4 md:p-3"
      />
    </a>

    <a
      href="/arcade/trivia"
      class="dark-club-card dark-club-card-yellow relative flex flex-col items-center gap-2 bg-white p-3 text-center transition md:items-stretch md:gap-0 md:p-5 md:text-left"
    >
      <div class="order-1 w-full md:order-2">
        <p class="hidden text-xs uppercase tracking-widest font-black text-slate-500 md:block">Gioco 02</p>
        <h2 class="text-base font-black leading-tight text-black highlight-yellow md:mt-3 md:text-3xl md:leading-none">Trivia</h2>
        <span class="mt-5 hidden justify-center md:flex">
          <span class="club-btn-yellow inline-block px-4 py-2">Gioca</span>
        </span>
      </div>

      <img
        src="/images/trivia.svg"
        alt="Trivia"
        loading="lazy"
        class="order-2 aspect-[16/9] w-full border-2 border-black bg-white object-contain p-2 md:order-1 md:mb-4 md:p-3"
      />
    </a>

    <a
      href="/arcade/legends"
      class="dark-club-card dark-club-card-blue relative flex flex-col items-center gap-2 bg-white p-3 text-center transition md:items-stretch md:gap-0 md:p-5 md:text-left"
    >
      <div class="order-1 w-full md:order-2">
        <p class="hidden text-xs uppercase tracking-widest font-black text-slate-500 md:block">Gioco 03</p>
        <h2 class="text-base font-black leading-tight text-black highlight-blue md:mt-3 md:text-3xl md:leading-none">Legends Game</h2>
        <span class="mt-5 hidden justify-center md:flex">
          <span class="club-btn-blue inline-block px-4 py-2">Gioca</span>
        </span>
      </div>

      <img
        src="https://res.cloudinary.com/diqgwitqg/image/upload/v1785160662/legends.png"
        alt="Legends Game"
        loading="lazy"
        class="order-2 aspect-[16/9] w-full border-2 border-black bg-white object-contain p-2 md:order-1 md:mb-4 md:p-3"
      />
    </a>

    <a
      href="/arcade/slice"
      class="dark-club-card dark-club-card-violet relative flex flex-col items-center gap-2 bg-white p-3 text-center transition md:items-stretch md:gap-0 md:p-5 md:text-left"
    >
      <div class="order-1 w-full md:order-2">
        <p class="hidden text-xs uppercase tracking-widest font-black text-slate-500 md:block">Gioco 04</p>
        <h2 class="text-base font-black leading-tight text-black highlight-violet md:mt-3 md:text-3xl md:leading-none">Slice</h2>
        <span class="mt-5 hidden justify-center md:flex">
          <span class="club-btn-yellow inline-block px-4 py-2">Gioca</span>
        </span>
      </div>

      <img
        src="https://res.cloudinary.com/diqgwitqg/image/upload/v1785160971/slice2.png"
        alt="Slice"
        loading="lazy"
        class="order-2 aspect-[16/9] w-full border-2 border-black bg-white object-contain p-2 md:order-1 md:mb-4 md:p-3"
      />
    </a>

    <a
      href="/arcade/supertris"
      class="dark-club-card dark-club-card-violet relative flex flex-col items-center gap-2 bg-white p-3 text-center transition md:items-stretch md:gap-0 md:p-5 md:text-left"
    >
      <div class="order-1 w-full md:order-2">
        <p class="hidden text-xs uppercase tracking-widest font-black text-slate-500 md:block">Gioco 05</p>
        <h2 class="text-base font-black leading-tight text-black highlight-violet md:mt-3 md:text-3xl md:leading-none">Super Tris</h2>
        <span class="mt-5 hidden justify-center md:flex">
          <span class="club-btn-yellow inline-block px-4 py-2">Gioca</span>
        </span>
      </div>

      <img
        src="/images/supertris.svg"
        alt="Super Tris"
        loading="lazy"
        class="order-2 aspect-[16/9] w-full border-2 border-black bg-white object-contain p-2 md:order-1 md:mb-4 md:p-3"
      />
    </a>

    <a
      href="/arcade/thebattle"
      class="dark-club-card dark-club-card-blue relative flex flex-col items-center gap-2 bg-white p-3 text-center transition md:items-stretch md:gap-0 md:p-5 md:text-left"
    >
      <div class="order-1 w-full md:order-2">
        <p class="hidden text-xs uppercase tracking-widest font-black text-slate-500 md:block">Gioco 06</p>
        <h2 class="text-base font-black leading-tight text-black highlight-blue md:mt-3 md:text-3xl md:leading-none">The Battle</h2>
        <span class="mt-5 hidden justify-center md:flex">
          <span class="club-btn-yellow inline-block px-4 py-2">Gioca</span>
        </span>
      </div>

      <img
        src="/images/thebattle.svg"
        alt="The Battle"
        loading="lazy"
        class="order-2 aspect-[16/9] w-full border-2 border-black bg-white object-contain p-2 md:order-1 md:mb-4 md:p-3"
      />
    </a>

    <a
      href="/arcade/quindici"
      class="dark-club-card dark-club-card-blue relative flex flex-col items-center gap-2 bg-white p-3 text-center transition md:items-stretch md:gap-0 md:p-5 md:text-left"
    >
      <div class="order-1 w-full md:order-2">
        <p class="hidden text-xs uppercase tracking-widest font-black text-slate-500 md:block">Gioco 07</p>
        <h2 class="text-base font-black leading-tight text-black highlight-blue md:mt-3 md:text-3xl md:leading-none">Quindici</h2>
        <span class="mt-5 hidden justify-center md:flex">
          <span class="club-btn-yellow inline-block px-4 py-2">Gioca</span>
        </span>
      </div>

      <img
        src="https://res.cloudinary.com/diqgwitqg/image/upload/v1785160662/quindici.png"
        alt="Quindici"
        loading="lazy"
        class="order-2 aspect-[16/9] w-full border-2 border-black bg-white object-contain p-2 md:order-1 md:mb-4 md:p-3"
      />
    </a>

    <a
      href="/arcade/classifica"
      class="dark-club-card dark-club-card-green relative flex flex-col items-center gap-2 bg-white p-3 text-center transition md:items-stretch md:gap-0 md:p-5 md:text-left"
    >
      <div class="order-1 w-full md:order-2">
        <p class="hidden text-xs uppercase tracking-widest font-black text-slate-500 md:block">Gioco 08</p>
        <h2 class="text-base font-black leading-tight text-black highlight-blue md:mt-3 md:text-3xl md:leading-none">Classifica</h2>
        <span class="mt-5 hidden justify-center md:flex">
          <span class="club-btn-yellow inline-block px-4 py-2">Guarda</span>
        </span>
      </div>

      <div class="order-2 flex aspect-[16/9] w-full items-center justify-center border-2 border-black bg-slate-100 p-2 md:order-1 md:mb-4 md:p-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
          <path fill-rule="evenodd" d="M0 0h1v15h15v1H0zm10 3.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-1 0V4.9l-3.613 4.417a.5.5 0 0 1-.74.037L7.06 6.767l-3.656 5.027a.5.5 0 0 1-.808-.588l4-5.5a.5.5 0 0 1 .758-.06l2.609 2.61L13.445 4H10.5a.5.5 0 0 1-.5-.5"/>
        </svg>
      </div>
    </a>
  </div>
</Layout>
