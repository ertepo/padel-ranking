---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

const { data: scores, error } = await supabase
  .from('legends_game_score')
  .select('id, nickname, match_score, points, difficulty, created_at')
  .order('points', { ascending: false })
  .limit(15);

const { count: totalMatches } = await supabase
  .from('legends_game_score')
  .select('id', { count: 'exact', head: true });

const topScores = scores || [];

const { data: sliceScores, error: sliceError } = await supabase
  .from('slice_game_score')
  .select('id, nickname, points, board_snapshot, created_at')
  .order('points', { ascending: false })
  .limit(15);

const { count: totalSliceMatches } = await supabase
  .from('slice_game_score')
  .select('id', { count: 'exact', head: true });

const topSliceScores = sliceScores || [];

const { data: triviaScores, error: triviaError } = await supabase
  .from('trivia_game_score')
  .select('id, nickname, points, correct_count, total_questions, created_at')
  .order('points', { ascending: false })
  .limit(15);

const { count: totalTriviaMatches } = await supabase
  .from('trivia_game_score')
  .select('id', { count: 'exact', head: true });

const topTriviaScores = triviaScores || [];

const { data: chilhavintoScores, error: chilhavintoError } = await supabase
  .from('chilhavinto_game_score')
  .select('id, nickname, level_reached, created_at')
  .order('level_reached', { ascending: false })
  .limit(15);

const { count: totalChilhavintoMatches } = await supabase
  .from('chilhavinto_game_score')
  .select('id', { count: 'exact', head: true });

const topChilhavintoScores = chilhavintoScores || [];

const DIFFICULTY_LABELS: Record<string, string> = {
  '1': 'Liv. 1',
  '2': 'Liv. 2',
  '3': 'Liv. 3',
  '4': 'Liv. 4',
  '5': 'Liv. 5',
  ultra: 'Ultra',
};
---

<Layout
  title="Classifica Arcade"
  headerTheme="club"
  description="Le classifiche arcade di Tie-Break: i punteggi più alti di Legends Game e Slice, con nickname e risultato di ogni partita."
  fullBleed
>
  <section class="arcade">
    <div class="screen">
      <div class="bolt tl"></div>
      <div class="bolt tr"></div>
      <div class="bolt bl"></div>
      <div class="bolt br"></div>
      <div class="scanlines"></div>
      <div class="vignette"></div>
      <div class="flicker"></div>

      <div class="content">
        <p class="eyebrow">Tie-Break Poggio San Vicino — Sala Giochi</p>
        <h1 class="title">Classifica<span class="cursor"></span></h1>
        <p class="prompt">Insert coin — select your game</p>

        {
          error && (
            <pre class="err">{JSON.stringify(error, null, 2)}</pre>
          )
        }
        {
          sliceError && (
            <pre class="err">{JSON.stringify(sliceError, null, 2)}</pre>
          )
        }
        {
          triviaError && (
            <pre class="err">{JSON.stringify(triviaError, null, 2)}</pre>
          )
        }
        {
          chilhavintoError && (
            <pre class="err">{JSON.stringify(chilhavintoError, null, 2)}</pre>
          )
        }

        <div class="boards">
          <section class="board" id="board-legends">
            <div class="board-head">
              <div>
                <span class="name">Legends Game</span>
              </div>
              <span class="meta">Top 15 · {totalMatches ?? 0} partite</span>
            </div>

            {
              topScores.length === 0 ? (
                <p class="empty">Nessun punteggio ancora registrato: gioca la prima partita!</p>
              ) : (
                <ol class="board-list">
                  {topScores.map((score, index) => {
                    const difficultyLabel = DIFFICULTY_LABELS[score.difficulty] || score.difficulty || '—';
                    const isFirst = index === 0;
                    return (
                      <li class:list={['row', { first: isFirst, extra: index >= 6 }]}>
                        <div class="row-top">
                          <span class="rank">
                            <span class="caret">►</span>
                            {String(index + 1).padStart(2, '0')}
                          </span>
                          <span class="who">{score.nickname}</span>
                          <a class="mini-btn" href={`/arcade/legends?replay=${score.id}`}>
                            Fai meglio
                          </a>
                        </div>
                        <div class="row-sub">
                          <span class="sub">{score.match_score} · {difficultyLabel}</span>
                          <span class="leader" />
                          <span class="score">{score.points}</span>
                        </div>
                      </li>
                    );
                  })}
                </ol>
              )
            }

            {
              topScores.length > 6 && (
                <button type="button" class="show-more" data-board="board-legends">
                  Mostra altro
                </button>
              )
            }
          </section>

          <section class="board" id="board-slice">
            <div class="board-head">
              <div>
                <span class="name">Slice</span>
              </div>
              <span class="meta">Top 15 · {totalSliceMatches ?? 0} partite</span>
            </div>

            {
              topSliceScores.length === 0 ? (
                <p class="empty">Nessun punteggio ancora registrato: gioca la prima partita!</p>
              ) : (
                <ol class="board-list">
                  {topSliceScores.map((score, index) => {
                    const date = new Date(score.created_at).toLocaleDateString('it-IT');
                    const isFirst = index === 0;
                    return (
                      <li class:list={['row', { first: isFirst, extra: index >= 6 }]}>
                        <div class="row-top">
                          <span class="rank">
                            <span class="caret">►</span>
                            {String(index + 1).padStart(2, '0')}
                          </span>
                          <span class="who">{score.nickname}</span>
                          {score.board_snapshot && (
                            <button
                              type="button"
                              class="mini-btn ghost slice-board-btn"
                              data-slice-board={score.board_snapshot}
                            >
                              Info
                            </button>
                          )}
                        </div>
                        <div class="row-sub">
                          <span class="sub">{date}</span>
                          <span class="leader" />
                          <span class="score">{score.points}</span>
                        </div>
                      </li>
                    );
                  })}
                </ol>
              )
            }

            {
              topSliceScores.length > 6 && (
                <button type="button" class="show-more" data-board="board-slice">
                  Mostra altro
                </button>
              )
            }
          </section>

          <section class="board" id="board-trivia">
            <div class="board-head">
              <div>
                <span class="name">Trivia</span>
              </div>
              <span class="meta">Top 15 · {totalTriviaMatches ?? 0} partite</span>
            </div>

            {
              topTriviaScores.length === 0 ? (
                <p class="empty">Nessun punteggio ancora registrato: gioca la prima partita!</p>
              ) : (
                <ol class="board-list">
                  {topTriviaScores.map((score, index) => {
                    const isFirst = index === 0;
                    return (
                      <li class:list={['row', { first: isFirst, extra: index >= 6 }]}>
                        <div class="row-top">
                          <span class="rank">
                            <span class="caret">►</span>
                            {String(index + 1).padStart(2, '0')}
                          </span>
                          <span class="who">{score.nickname}</span>
                        </div>
                        <div class="row-sub">
                          <span class="sub">{score.correct_count}/{score.total_questions} corrette</span>
                          <span class="leader" />
                          <span class="score">{score.points}</span>
                        </div>
                      </li>
                    );
                  })}
                </ol>
              )
            }

            {
              topTriviaScores.length > 6 && (
                <button type="button" class="show-more" data-board="board-trivia">
                  Mostra altro
                </button>
              )
            }
          </section>

          <section class="board" id="board-chilhavinto">
            <div class="board-head">
              <div>
                <span class="name">Chi l'ha vinto?</span>
              </div>
              <span class="meta">Top 15 · {totalChilhavintoMatches ?? 0} partite</span>
            </div>

            {
              topChilhavintoScores.length === 0 ? (
                <p class="empty">Nessun punteggio ancora registrato: gioca la prima partita!</p>
              ) : (
                <ol class="board-list">
                  {topChilhavintoScores.map((score, index) => {
                    const isFirst = index === 0;
                    return (
                      <li class:list={['row', { first: isFirst, extra: index >= 6 }]}>
                        <div class="row-top">
                          <span class="rank">
                            <span class="caret">►</span>
                            {String(index + 1).padStart(2, '0')}
                          </span>
                          <span class="who">{score.nickname}</span>
                        </div>
                        <div class="row-sub">
                          <span class="sub">livello raggiunto</span>
                          <span class="leader" />
                          <span class="score">{score.level_reached}</span>
                        </div>
                      </li>
                    );
                  })}
                </ol>
              )
            }

            {
              topChilhavintoScores.length > 6 && (
                <button type="button" class="show-more" data-board="board-chilhavinto">
                  Mostra altro
                </button>
              )
            }
          </section>
        </div>

        <p class="eyebrow" style="margin-top: 2.5rem;">Gioca ora</p>
        <div class="foot">
          <a class="cab-btn primary" href="/arcade/legends">► Legends Game</a>
          <a class="cab-btn primary" href="/arcade/slice">► Slice</a>
          <a class="cab-btn primary" href="/arcade/trivia">► Trivia</a>
          <a class="cab-btn primary" href="/arcade/chilhavinto">► Chi l'ha vinto?</a>
        </div>
      </div>
    </div>
  </section>

  <dialog id="slice-board-modal" class="board-modal">
    <div class="board-modal-head">
      <h3>Board finale</h3>
      <button type="button" id="slice-board-modal-close" aria-label="Chiudi">×</button>
    </div>
    <div class="club-card p-4">
      <div id="slice-board-modal-grid" class="relative w-full aspect-square border-2 border-black bg-slate-100"></div>
    </div>
  </dialog>
</Layout>

<script>
  import { LABELS, parseBoardSnapshot } from '../../lib/slice/engine';
  import { tileBackground, tileTextColor } from '../../lib/slice/tileStyle';

  const dialog = document.getElementById('slice-board-modal') as HTMLDialogElement | null;
  const grid = document.getElementById('slice-board-modal-grid');
  const closeBtn = document.getElementById('slice-board-modal-close');

  const SIZE = 4;

  // Stessa formula di misura di SliceBoard.svelte: gap proporzionale alla
  // larghezza, celle quadrate che riempiono il resto della board.
  function fontSize(level: number, cell: number): number {
    const len = LABELS[level].length;
    if (len > 5) return Math.round(cell * 0.24);
    if (len > 2) return Math.round(cell * 0.3);
    return Math.round(cell * 0.42);
  }

  function renderBoard(snapshot: string) {
    if (!grid) return;
    grid.innerHTML = '';

    const w = grid.clientWidth;
    const gap = Math.round(w * 0.026);
    const cell = (w - gap * (SIZE + 1)) / SIZE;
    const pos = (i: number) => gap + i * (cell + gap);

    const levels = parseBoardSnapshot(snapshot);

    levels.forEach((_, i) => {
      const bg = document.createElement('div');
      bg.className = 'absolute bg-slate-200';
      bg.style.cssText = `width:${cell}px;height:${cell}px;left:${pos(i % SIZE)}px;top:${pos(Math.floor(i / SIZE))}px`;
      grid.appendChild(bg);
    });

    levels.forEach((level, i) => {
      if (level === null) return;
      const tile = document.createElement('div');
      tile.className = 'absolute flex items-center justify-center border-2 border-black font-black text-center';
      tile.style.cssText = `width:${cell}px;height:${cell}px;left:${pos(i % SIZE)}px;top:${pos(Math.floor(i / SIZE))}px;font-size:${fontSize(level, cell)}px;background:${tileBackground(level)};color:${tileTextColor(level)}`;

      if (level === 0) {
        const ball = document.createElement('span');
        const size = Math.round(cell * 0.35);
        ball.style.cssText = `display:block;width:${size}px;height:${size}px;border-radius:9999px;border:1px solid black;background:var(--giallo-club)`;
        tile.appendChild(ball);
      } else if (level >= 4 && level <= 9) {
        const num = document.createElement('span');
        num.className = 'leading-none';
        num.style.fontSize = `${Math.round(cell * 0.46)}px`;
        num.textContent = String(level - 3);
        const game = document.createElement('span');
        game.className = 'absolute bottom-1 left-0 right-0 text-center leading-none tracking-widest';
        game.style.fontSize = `${Math.round(cell * 0.13)}px`;
        game.textContent = 'GAME';
        tile.append(num, game);
      } else {
        const label = document.createElement('span');
        label.className = 'leading-none';
        label.textContent = LABELS[level];
        tile.appendChild(label);
      }

      grid.appendChild(tile);
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.slice-board-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const snapshot = btn.dataset.sliceBoard;
      if (!snapshot || !dialog) return;
      dialog.showModal();
      renderBoard(snapshot);
    });
  });

  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  // "Mostra altro" rivela le posizioni 7-15 di quella classifica; ricliccando
  // le richiude e riporta la vista in cima a QUELLA classifica (non in cima
  // alla pagina), compensando l'header sticky del sito come già fa
  // ScambioGame/SliceGame con document.querySelector('header').
  document.querySelectorAll<HTMLButtonElement>('.show-more').forEach((btn) => {
    btn.addEventListener('click', () => {
      const board = btn.dataset.board ? document.getElementById(btn.dataset.board) : null;
      if (!board) return;

      const expanded = board.classList.toggle('expanded');
      btn.textContent = expanded ? 'Mostra meno' : 'Mostra altro';

      if (!expanded) {
        const header = document.querySelector('header');
        const headerOffset = header ? header.getBoundingClientRect().height : 0;
        const top = board.getBoundingClientRect().top + window.scrollY - headerOffset - 12;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    });
  });
</script>

<style>
  .arcade {
    --yellow: var(--giallo-club);
    --yellow-dim: #a67f00;
    --bg: #0a0a0c;
    --fg: #f3f3ec;
    --fg-dim: #9a9a92;
    --line: rgba(243, 243, 236, 0.16);
    --line-strong: rgba(255, 204, 0, 0.55);
    --mono: ui-monospace, 'Cascadia Mono', 'Segoe UI Mono', 'Roboto Mono', Consolas, 'Liberation Mono', monospace;
    font-family: var(--mono);
    display: block;
  }

  .screen {
    position: relative;
    background: var(--bg);
    border: 2px solid var(--yellow-dim);
    outline: 1px solid rgba(0, 0, 0, 0.8);
    outline-offset: -6px;
    overflow: hidden;
  }

  .bolt {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--yellow-dim);
    opacity: 0.6;
  }
  .bolt.tl { top: 10px; left: 10px; }
  .bolt.tr { top: 10px; right: 10px; }
  .bolt.bl { bottom: 10px; left: 10px; }
  .bolt.br { bottom: 10px; right: 10px; }

  .scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.05) 0px,
      rgba(255, 255, 255, 0.05) 1px,
      transparent 1px,
      transparent 3px
    );
    mix-blend-mode: overlay;
  }

  .vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 40%, transparent 55%, rgba(0, 0, 0, 0.65) 100%);
  }

  .flicker {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: rgba(255, 204, 0, 0.02);
    animation: arcade-flicker 6s infinite steps(1);
  }
  @keyframes arcade-flicker {
    0%, 92%, 100% { opacity: 0; }
    93% { opacity: 1; }
    94% { opacity: 0; }
    96% { opacity: 0.6; }
    97% { opacity: 0; }
  }

  .content {
    position: relative;
    z-index: 1;
    padding: 2.75rem 1.5rem 2.25rem;
    max-width: 1080px;
    margin: 0 auto;
    color: var(--fg);
  }

  .eyebrow {
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--yellow-dim);
    margin: 0 0 1rem;
  }

  .title {
    font-family: var(--mono);
    text-align: center;
    font-size: clamp(2.1rem, 7vw, 3.6rem);
    line-height: 1;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: var(--fg);
    text-shadow:
      0 0 1px var(--fg),
      0 3px 0 var(--yellow-dim),
      0 0 22px rgba(255, 204, 0, 0.35);
  }

  .cursor {
    display: inline-block;
    background: var(--yellow);
    width: 0.5em;
    height: 0.85em;
    margin-left: 0.12em;
    vertical-align: -0.12em;
    animation: arcade-blink 1s steps(1) infinite;
  }
  @keyframes arcade-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .prompt {
    text-align: center;
    margin: 0.9rem 0 0;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--yellow);
    animation: arcade-blink-slow 1.6s steps(1) infinite;
  }
  @keyframes arcade-blink-slow {
    0%, 60% { opacity: 1; }
    80% { opacity: 0.15; }
    100% { opacity: 1; }
  }

  .err {
    margin: 1.5rem 0 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line-strong);
    color: #ff8a8a;
    font-size: 11px;
    overflow-x: auto;
  }

  .boards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  @media (max-width: 640px) {
    .boards { grid-template-columns: 1fr; }
  }

  .board {
    border: 1px solid var(--line);
  }

  .board-head {
    border-bottom: 1px solid var(--line-strong);
    padding: 0.85rem 1rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .board-head .name {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--yellow);
  }

  .board-head .desc {
    margin: 0.2rem 0 0;
    font-size: 10.5px;
    color: var(--fg-dim);
  }

  .board-head .meta {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-dim);
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .empty {
    padding: 1.5rem 1rem;
    text-align: center;
    font-size: 12px;
    color: var(--fg-dim);
  }

  .board-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0;
  }

  .row {
    padding: 0.5rem 1rem;
    font-size: 13px;
  }

  .row-top {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .row-sub {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-left: 1.85em;
    margin-top: 0.15rem;
  }

  .row .rank {
    color: var(--yellow-dim);
    font-variant-numeric: tabular-nums;
    flex: 0 0 auto;
  }

  .row .who {
    flex: 1 1 auto;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row .leader {
    flex: 1 1 auto;
    border-bottom: 2px dotted var(--line);
    transform: translateY(-0.32em);
    min-width: 0.75rem;
  }

  .row .sub {
    color: var(--fg-dim);
    font-size: 11px;
    flex: 0 0 auto;
  }

  .row .score {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    flex: 0 0 auto;
    min-width: 3.4em;
    text-align: right;
  }

  .row.first {
    background: rgba(255, 204, 0, 0.06);
  }
  .row.first .rank,
  .row.first .who,
  .row.first .score {
    color: var(--yellow);
  }
  .row.first .leader {
    border-bottom-color: var(--line-strong);
  }

  .row .caret {
    display: inline-block;
    margin-right: 0.1em;
    animation: arcade-blink 1s steps(1) infinite;
  }
  .row:not(.first) .caret { visibility: hidden; }

  .board:not(.expanded) .row.extra {
    display: none;
  }

  .show-more {
    display: block;
    width: 100%;
    padding: 0.6rem;
    background: transparent;
    border: none;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: var(--yellow-dim);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .show-more:hover,
  .show-more:focus-visible {
    background: rgba(255, 204, 0, 0.08);
    color: var(--yellow);
    outline: none;
  }

  .mini-btn {
    font-family: var(--mono);
    flex: 0 0 auto;
    background: transparent;
    border: 1px solid var(--yellow);
    color: var(--yellow);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.28rem 0.55rem;
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .mini-btn:hover,
  .mini-btn:focus-visible {
    background: var(--yellow);
    color: #0a0a0c;
    outline: none;
  }
  .mini-btn.ghost {
    border-color: var(--line);
    color: var(--fg-dim);
  }
  .mini-btn.ghost:hover,
  .mini-btn.ghost:focus-visible {
    background: var(--fg-dim);
    color: #0a0a0c;
  }

  .foot {
    margin-top: 0.75rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cab-btn {
    font-family: var(--mono);
    background: transparent;
    color: var(--yellow);
    border: 2px solid var(--yellow);
    padding: 0.65rem 1.1rem;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 700;
