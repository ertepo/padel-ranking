---
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";

const { data: players, error } = await supabase
    .from("padel_rankings")
    .select(
        `
    player_id,
    current_elo,
    matches_played,
    wins,
    losses,
    players (
      id,
      name
    )
  `,
    )
    .eq("active", true)
    .order("current_elo", { ascending: false });

const { data: lastMatches } = await supabase
    .from("match_players")
    .select(`
    player_id,
    elo_before,
    elo_after,
    matches!inner (
      created_at
    )`)
    .order("created_at", { referencedTable: "matches", ascending: false });

// Mappa player_id → delta dell'ultimo match
const lastMatchMap: Record<string, number> = {};

for (const row of lastMatches || []) {
    if (!(row.player_id in lastMatchMap)) {
        lastMatchMap[row.player_id] = row.elo_after - row.elo_before;
    }
}

const activePlayers = players || [];
const rankedPlayers = activePlayers
    .filter((player) => player.matches_played > 0)
    .sort((a, b) => {
        if (b.current_elo !== a.current_elo) {
            return b.current_elo - a.current_elo;
        }

        return a.players.name.localeCompare(b.players.name, "it");
    });
const debutPlayers = activePlayers
    .filter((player) => player.matches_played === 0)
    .sort((a, b) => a.players.name.localeCompare(b.players.name, "it"));
---

<Layout
    title="Classifica Padel"
    image="/images/og/og-image-padel-ranking.png"
    description="Classifica padel aggiornata del circolo Tie-Break Poggio San Vicino, con punteggi ELO, partite giocate, vittorie e win rate."
    headerTheme="padel"
>
    <section class="mb-8">
        <p class="text-sm uppercase tracking-widest font-black text-slate-600">
            Padel Ranking
        </p>

        <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
            Classifica Padel
        </h1>
    </section>

    {
        error && (
            <pre class="club-card p-4 text-red-600 mb-6">
                {JSON.stringify(error, null, 2)}
            </pre>
        )
    }

    <div class="club-card overflow-hidden">
        <div
            class="bg-[var(--giallo-club)] border-b-2 border-black p-4 flex justify-between items-center"
        >
            <h2 class="text-xl font-black uppercase">Classifica a punti</h2>

            <button
                id="toggle-zero-matches"
                type="button"
                class="club-btn px-3 py-1 text-xs uppercase"
            >
                Nascondi inattivi
            </button>
        </div>
        <div
            class="hidden md:grid grid-cols-[4rem_1fr_6rem_5rem_5rem_5rem] gap-3 px-4 py-2 bg-slate-100 border-b-2 border-black font-black text-xs uppercase text-slate-600"
        >
            <div>Pos</div>
            <div>Giocatore</div>
            <div class="text-right">Punti</div>
            <div class="text-right">Partite</div>
            <div class="text-right">Vittorie</div>
            <div class="text-right">Win Rate</div>
        </div>
        <div class="divide-y-2 divide-black">
            {
                rankedPlayers.map((player, index) => {
                    const winRate =
                        player.matches_played > 0
                            ? Math.round(
                                  (player.wins / player.matches_played) * 100,
                              )
                            : 0;
                    const eloDelta = lastMatchMap[player.player_id] ?? 0;
                    return (
                        <a
                            href={`/player/${player.player_id}`}
                            data-ranking-row
                            data-matches-played={player.matches_played}
                            class="grid grid-cols-[3rem_1fr_auto] md:grid-cols-[4rem_1fr_6rem_5rem_5rem_5rem] gap-3 items-center p-4 bg-white hover:bg-[var(--giallo-club)] transition"
                        >
                            <div class="text-3xl font-black text-black">
                                #{index + 1}
                            </div>

                            <div>
                                <div class="font-black text-xl text-black flex items-center gap-2">
                                    <span>
                                        {eloDelta > 0 && (
                                            <span class="text-green-600">
                                                ▲
                                            </span>
                                        )}
                                        {eloDelta < 0 && (
                                            <span class="text-red-600">▼</span>
                                        )}
                                        {eloDelta === 0 && (
                                            <span class="text-gray-400">–</span>
                                        )}
                                    </span>
                                    {player.players.name}
                                </div>

                                <div class="text-sm font-bold text-slate-600 md:hidden">
                                    {player.matches_played} partite ·{" "}
                                    {player.wins}V/{player.losses}P · {winRate}%
                                </div>
                            </div>

                            <div class="text-right font-black text-2xl text-black">
                                {player.current_elo}
                            </div>

                            <div class="hidden md:block text-right font-bold">
                                {player.matches_played}
                            </div>

                            <div class="hidden md:block text-right font-bold">
                                {player.wins}V
                            </div>

                            <div class="hidden md:block text-right font-bold">
                                {winRate}%
                            </div>
                        </a>
                    );
                })
            }

            {debutPlayers.length > 0 && (
                <div
                    data-zero-matches-section
                    class="bg-slate-100 px-4 py-3 text-xs font-black uppercase tracking-widest text-slate-600"
                >
                    In attesa di debutto
                </div>
            )}

            {
                debutPlayers.map((player) => {
                    const eloDelta = lastMatchMap[player.player_id] ?? 0;
                    return (
                        <a
                            href={`/player/${player.player_id}`}
                            data-ranking-row
                            data-zero-matches-player
                            data-matches-played={player.matches_played}
                            class="grid grid-cols-[3rem_1fr_auto] md:grid-cols-[4rem_1fr_6rem_5rem_5rem_5rem] gap-3 items-center p-4 bg-white hover:bg-[var(--giallo-club)] transition"
                        >
                            <div class="text-3xl font-black text-slate-400">
                                NC
                            </div>

                            <div>
                                <div class="font-black text-xl text-black flex items-center gap-2">
                                    <span>
                                        {eloDelta > 0 && (
                                            <span class="text-green-600">
                                                ▲
                                            </span>
                                        )}
                                        {eloDelta < 0 && (
                                            <span class="text-red-600">▼</span>
                                        )}
                                        {eloDelta === 0 && (
                                            <span class="text-gray-400">–</span>
                                        )}
                                    </span>
                                    {player.players.name}
                                </div>

                                <div class="text-sm font-bold text-slate-600 md:hidden">
                                    In attesa della prima partita
                                </div>
                            </div>

                            <div class="text-right font-black text-2xl text-black">
                                {player.current_elo}
                            </div>

                            <div class="hidden md:block text-right font-bold">
                                0
                            </div>

                            <div class="hidden md:block text-right font-bold">
                                0V
                            </div>

                            <div class="hidden md:block text-right font-bold">
                                -
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </div>

    <script is:inline>
        const toggleZeroMatchesButton = document.getElementById("toggle-zero-matches");
        const rankingRows = Array.from(document.querySelectorAll("[data-ranking-row]"));
        const zeroMatchesSection = document.querySelector("[data-zero-matches-section]");
        let hideZeroMatches = false;

        function updateZeroMatchesVisibility() {
            rankingRows.forEach((row) => {
                const matchesPlayed = Number(row.dataset.matchesPlayed || 0);
                row.hidden = hideZeroMatches && matchesPlayed === 0;
            });

            if (zeroMatchesSection) {
                zeroMatchesSection.hidden = hideZeroMatches;
            }

            toggleZeroMatchesButton.textContent = hideZeroMatches
                ? "Mostra inattivi"
                : "Nascondi inattivi";
        }

        toggleZeroMatchesButton?.addEventListener("click", () => {
            hideZeroMatches = !hideZeroMatches;
            updateZeroMatchesVisibility();
        });
    </script>
</Layout>
