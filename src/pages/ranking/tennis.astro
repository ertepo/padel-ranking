---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

// Recuperiamo ranking tennis + dati anagrafici
const { data: players, error } = await supabase
  .from('tennis_rankings')
  .select(`
    *,
    players (
      id,
      name
    )
  `)
  .order('position', { ascending: true });
---

<Layout title="Classifica Tennis">
  <section class="mb-8">
    <p class="text-sm uppercase tracking-widest font-black text-slate-600">
      Tennis Ranking
    </p>

    <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
      Classifica Tennis
    </h1>
  </section>

  {error && (
    <pre class="club-card p-4 text-red-600 mb-6">
      {JSON.stringify(error, null, 2)}
    </pre>
  )}

  <div class="club-card overflow-hidden">
    <div class="bg-[var(--giallo-club)] border-b-2 border-black p-4 flex justify-between items-center">
      <h2 class="text-xl font-black uppercase">
        Classifica a Scala
      </h2>

      <span class="bg-black text-white px-3 py-1 text-xs font-black uppercase">
        SCALA
      </span>
    </div>

    {/* Header desktop */}
    <div class="hidden md:grid grid-cols-[4rem_1fr_6rem_5rem_5rem_5rem] gap-3 px-4 py-2 bg-slate-100 border-b-2 border-black font-black text-xs uppercase text-slate-600">
      <div>Pos</div>
      <div>Giocatore</div>
      <div class="text-right">Partite</div>
      <div class="text-right">Vittorie</div>
      <div class="text-right">Sconfitte</div>
      <div class="text-right">Win Rate</div>
    </div>

    <div class="divide-y-2 divide-black">
      {players?.map((player) => {

        const winRate =
          player.matches_played > 0
            ? Math.round(
                (player.wins / player.matches_played) * 100
              )
            : 0;

        const movement =
          player.previous_position
            ? player.position - player.previous_position
            : 0;

        return (
          <a
            href={`/player/${player.player_id}`}
            class="grid grid-cols-[3rem_1fr_auto] md:grid-cols-[4rem_1fr_6rem_5rem_5rem_5rem] gap-3 items-center p-4 bg-white hover:bg-[var(--giallo-club)] transition"
          >

            {/* Posizione */}
            <div class="text-3xl font-black text-black">
              #{player.position}
            </div>

            {/* Info giocatore */}
            <div>
              <div class="font-black text-xl text-black flex items-center gap-2">

                <span class="text-xl">
                  {movement < 0 && (
                    <span class="text-green-600">▲</span>
                  )}

                  {movement > 0 && (
                    <span class="text-red-600">▼</span>
                  )}

                  {movement === 0 && (
                    <span class="text-gray-400">–</span>
                  )}
                </span>

                {player.players.name}
              </div>

              {/* Mobile */}
              <div class="text-sm font-bold text-slate-600 md:hidden">
                {player.matches_played} partite ·
                {' '}
                {player.wins}V/{player.losses}P ·
                {' '}
                {winRate}%
              </div>
            </div>

            {/* Desktop stats */}
            <div class="hidden md:block text-right font-bold text-black">
              {player.matches_played}
            </div>

            <div class="hidden md:block text-right font-bold text-black">
              {player.wins}V
            </div>

            <div class="hidden md:block text-right font-bold text-black">
              {player.losses}P
            </div>

            <div class="hidden md:block text-right font-black text-xl text-black">
              {winRate}%
            </div>

            {/* Mobile arrow */}
            <div class="md:hidden text-right font-black text-slate-400">
              →
            </div>

          </a>
        );
      })}
    </div>
  </div>
</Layout>