---
import { supabase } from "../../lib/supabase";
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";

const adminPassword = Astro.cookies.get("admin_password");

if (adminPassword?.value !== import.meta.env.ADMIN_PASSWORD) {
    const redirectTo = encodeURIComponent(Astro.url.pathname);
    return Astro.redirect(`/login?redirect=${redirectTo}`);
}

// Recupera partita attiva (live o waiting)
const { data: activeMatch } = await supabase
    .from("live_score")
    .select("*")
    .in("status", ["live", "waiting"])
    .order("created_at", { ascending: false })
    .limit(1)
    .single();
---

<Layout title="Admin Live Score" noindex={true}>
    <section class="mb-8">
        <p class="text-sm uppercase tracking-widest font-black text-slate-600">
            Area riservata
        </p>
        <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
            Live Score
        </h1>
        <p class="mt-4 max-w-xl text-slate-700 font-medium">
            Gestisci la partita in diretta. I punti vengono trasmessi in tempo reale.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
            <a href="/admin/tennis" class="club-btn px-5 py-3">← Admin Tennis</a>
            <a href="/livescore" target="_blank" class="club-btn px-5 py-3">👁 Apri vista pubblica</a>
        </div>
    </section>

    <div id="livescore-admin" data-match={JSON.stringify(activeMatch ?? null)}></div>
</Layout>

<style>
  /* Stile brutalist coerente col sito */
  :global(#livescore-admin) {
    font-family: inherit;
  }

  :global(.ls-card) {
    border: 2px solid black;
    box-shadow: 6px 6px 0 0 rgba(0,0,0,1);
    background: white;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  :global(.ls-btn) {
    border: 2px solid black;
    box-shadow: 4px 4px 0 0 rgba(0,0,0,1);
    font-weight: 900;
    font-size: 1.1rem;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    transition: transform 0.08s, box-shadow 0.08s;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: white;
  }

  :global(.ls-btn:active) {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 0 rgba(0,0,0,1);
  }

  :global(.ls-btn-a) { background: #bbf7d0; }
  :global(.ls-btn-b) { background: #fde68a; }
  :global(.ls-btn-danger) { background: #fecaca; }
  :global(.ls-btn-primary) { background: #bfdbfe; }

  :global(.ls-point-btn) {
    width: 100%;
    padding: 2rem 1rem;
    font-size: 1.5rem;
    font-weight: 900;
    border: 3px solid black;
    box-shadow: 6px 6px 0 0 rgba(0,0,0,1);
    cursor: pointer;
    transition: transform 0.08s, box-shadow 0.08s;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.ls-point-btn:active) {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0 0 rgba(0,0,0,1);
  }

  :global(.ls-score-display) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    text-align: center;
    border: 3px solid black;
    padding: 1.5rem;
    background: #f8f8f8;
    margin-bottom: 1rem;
  }

  :global(.ls-score-big) {
    font-size: 5rem;
    font-weight: 900;
    line-height: 1;
  }

  :global(.ls-score-vs) {
    font-size: 1.5rem;
    font-weight: 900;
    color: #666;
  }

  :global(.ls-sets-row) {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  :global(.ls-set-badge) {
    border: 2px solid black;
    padding: 0.25rem 0.75rem;
    font-weight: 900;
    font-size: 0.9rem;
    background: white;
  }

  :global(.ls-set-won) { background: #bbf7d0; }

  :global(.ls-input) {
    border: 2px solid black;
    padding: 0.6rem 0.8rem;
    font-weight: 700;
    font-size: 1rem;
    width: 100%;
    margin-top: 0.25rem;
  }

  :global(.ls-label) {
    font-weight: 900;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #444;
  }

  :global(.ls-serve-indicator) {
    display: inline-block;
    width: 12px;
    height: 12px;
    background: #22c55e;
    border-radius: 50%;
    border: 2px solid black;
    vertical-align: middle;
    margin-right: 4px;
  }

  :global(.ls-status-badge) {
    display: inline-block;
    border: 2px solid black;
    padding: 0.2rem 0.75rem;
    font-weight: 900;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  :global(.ls-status-live) { background: #fef08a; }
  :global(.ls-status-waiting) { background: #e0e0e0; }
  :global(.ls-status-finished) { background: #bbf7d0; }

  :global(.ls-toast) {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 9999;
    border: 2px solid black;
    box-shadow: 6px 6px 0 black;
    padding: 1rem 1.5rem;
    font-weight: 900;
    font-size: 1rem;
    transition: opacity 0.5s, transform 0.5s;
  }

  :global(.ls-toast-error) { background: #fecaca; }
  :global(.ls-toast-ok) { background: #bbf7d0; }
</style>

<script>
import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const sb = createClient(SUPABASE_URL, SUPABASE_ANON);

// ─── Helpers ────────────────────────────────────────────────────────────────

const POINT_LABELS = ['0', '15', '30', '40'];

function pointLabel(p, opponent) {
  if (p === 4) return 'Van.';
  if (p === -4) return ''; // unused here
  if (p === 3 && opponent === 3) return '40';
  return POINT_LABELS[Math.min(p, 3)] ?? '0';
}

function formatPoints(match) {
  const a = match.points_a;
  const b = match.points_b;
  if (a === 4) return { a: 'Van', b: '40' };
  if (b === 4) return { a: '40', b: 'Van' };
  return {
    a: POINT_LABELS[Math.min(a, 3)] ?? '0',
    b: POINT_LABELS[Math.min(b, 3)] ?? '0',
  };
}

function showToast(msg, type = 'ok') {
  const t = document.createElement('div');
  t.className = `ls-toast ls-toast-${type}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translateX(120%)'; }, 2000);
  setTimeout(() => t.remove(), 2600);
}

// ─── State ───────────────────────────────────────────────────────────────────

const container = document.getElementById('livescore-admin');
let match = JSON.parse(container?.dataset.match ?? 'null');

// ─── Render ──────────────────────────────────────────────────────────────────

function render() {
  if (!container) return;
  container.innerHTML = match ? renderMatch() : renderNewMatch();
  attachEvents();
}

function renderNewMatch() {
  return `
    <div class="ls-card max-w-2xl">
      <h2 class="text-2xl font-black mb-6">Nuova partita</h2>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="ls-label">Sport</label>
          <select id="sport" class="ls-input">
            <option value="tennis">Tennis</option>
            <option value="padel">Padel</option>
          </select>
        </div>
        <div>
          <label class="ls-label">Tipo</label>
          <select id="match_type" class="ls-input">
            <option value="singles">Singolo</option>
            <option value="doubles">Doppio</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="ls-label">Team / Giocatore A</label>
          <input id="team_a" class="ls-input" type="text" placeholder="Es. Marco" value="" />
        </div>
        <div>
          <label class="ls-label">Team / Giocatore B</label>
          <input id="team_b" class="ls-input" type="text" placeholder="Es. Luca" value="" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <label class="ls-label">Numero set</label>
          <select id="max_sets" class="ls-input">
            <option value="3">Al meglio di 3</option>
            <option value="5">Al meglio di 5</option>
          </select>
        </div>
        <div>
          <label class="ls-label">Etichetta partita (opz.)</label>
          <input id="match_label" class="ls-input" type="text" placeholder="Es. Semifinale" />
        </div>
      </div>
      <div class="mb-6">
        <label class="ls-label">Chi serve per primo?</label>
        <div class="flex gap-3 mt-2">
          <button class="ls-btn ls-btn-a" id="serve-a">Team A serve</button>
          <button class="ls-btn ls-btn-b" id="serve-b">Team B serve</button>
        </div>
        <p id="serve-hint" class="text-sm text-slate-500 mt-1">Nessuno selezionato</p>
      </div>
      <button id="create-match" class="ls-btn ls-btn-primary w-full p-4 text-xl">
        ▶ Crea partita
      </button>
    </div>
  `;
}

function renderMatch() {
  const sets = match.sets ?? [];
  const pts = formatPoints(match);
  const setsToWin = Math.ceil(match.max_sets / 2);
  const setsA = sets.filter(s => s.a > s.b).length;
  const setsB = sets.filter(s => s.b > s.a).length;

  const statusLabel = { waiting: 'In attesa', live: 'Live', finished: 'Terminata' }[match.status] ?? match.status;
  const statusClass = `ls-status-${match.status}`;

  const servingA = match.serving === 'a';
  const servingB = match.serving === 'b';

  // Set history pills
  const setPills = sets.map((s, i) => {
    const wonA = s.a > s.b;
    const wonB = s.b > s.a;
    return `<span class="ls-set-badge ${wonA ? 'ls-set-won' : ''}">Set ${i+1}: ${s.a}-${s.b}</span>`;
  }).join('');

  return `
    <div class="max-w-2xl">
      <!-- Header info -->
      <div class="ls-card mb-4">
        <div class="flex items-center gap-3 flex-wrap mb-2">
          <span class="ls-status-badge ${statusClass}">${statusLabel}</span>
          <span class="font-bold text-lg">${match.sport === 'padel' ? '🏓' : '🎾'} ${match.match_type === 'doubles' ? 'Doppio' : 'Singolo'}</span>
          ${match.match_label ? `<span class="text-slate-500 font-medium italic">${match.match_label}</span>` : ''}
        </div>
        <p class="text-sm text-slate-500">Set: ${setsA}-${setsB} (vince a ${setsToWin})</p>
        ${sets.length ? `<div class="ls-sets-row mt-2">${setPills}</div>` : ''}
      </div>

      <!-- Score display -->
      <div class="ls-card">
        <div class="ls-score-display mb-4">
          <div>
            <div class="text-xl font-black">${servingA ? '<span class="ls-serve-indicator"></span>' : ''}${match.team_a_name}</div>
            <div class="ls-score-big text-green-600">${pts.a}</div>
            <div class="text-2xl font-black text-slate-400">${match.games_a} game</div>
          </div>
          <div class="ls-score-vs">VS</div>
          <div>
            <div class="text-xl font-black">${servingB ? '<span class="ls-serve-indicator"></span>' : ''}${match.team_b_name}</div>
            <div class="ls-score-big text-yellow-500">${pts.b}</div>
            <div class="text-2xl font-black text-slate-400">${match.games_b} game</div>
          </div>
        </div>

        <!-- Pulsantoni punto -->
        ${match.status !== 'finished' ? `
        <div class="grid grid-cols-2 gap-4 mb-4">
          <button class="ls-point-btn" id="point-a" style="background:#bbf7d0">
            +1 punto<br/><span style="font-size:1rem;opacity:0.7">${match.team_a_name}</span>
          </button>
          <button class="ls-point-btn" id="point-b" style="background:#fde68a">
            +1 punto<br/><span style="font-size:1rem;opacity:0.7">${match.team_b_name}</span>
          </button>
        </div>
        <div class="grid grid-cols-2 gap-3 mb-4">
          <button class="ls-btn" id="undo-point">↩ Annulla ultimo punto</button>
          <button class="ls-btn" id="toggle-serve">⟳ Cambia servizio</button>
        </div>
        ` : `
        <div class="text-center py-4">
          <p class="text-3xl font-black">🏆 Partita terminata!</p>
          <p class="text-xl mt-2 font-bold">Vince: ${match.winner === 'a' ? match.team_a_name : match.team_b_name}</p>
        </div>
        `}

        <!-- Azioni partita -->
        <div class="flex flex-wrap gap-3 pt-4 border-t-2 border-black">
          ${match.status === 'waiting' ? `<button class="ls-btn ls-btn-primary" id="start-match">▶ Inizia partita</button>` : ''}
          ${match.status === 'live' ? `<button class="ls-btn ls-btn-danger" id="finish-match">🏁 Termina partita</button>` : ''}
          <button class="ls-btn ls-btn-danger" id="delete-match" style="margin-left:auto">🗑 Elimina partita</button>
        </div>
      </div>
    </div>
  `;
}

// ─── Events ──────────────────────────────────────────────────────────────────

let servingSelected = 'a';
let history = []; // stack degli stati precedenti per undo

function attachEvents() {
  // ── Nuova partita ──
  const serveABtn = document.getElementById('serve-a');
  const serveBBtn = document.getElementById('serve-b');
  const serveHint = document.getElementById('serve-hint');

  serveABtn?.addEventListener('click', () => {
    servingSelected = 'a';
    serveHint.textContent = '✅ Team A serve';
    serveABtn.style.outline = '3px solid black';
    serveBBtn.style.outline = '';
  });

  serveBBtn?.addEventListener('click', () => {
    servingSelected = 'b';
    serveHint.textContent = '✅ Team B serve';
    serveBBtn.style.outline = '3px solid black';
    serveABtn.style.outline = '';
  });

  document.getElementById('create-match')?.addEventListener('click', async () => {
    const teamA = document.getElementById('team_a')?.value.trim();
    const teamB = document.getElementById('team_b')?.value.trim();
    if (!teamA || !teamB) { showToast('Inserisci i nomi dei giocatori', 'error'); return; }

    const { data, error } = await sb.from('live_score').insert({
      sport: document.getElementById('sport')?.value,
      match_type: document.getElementById('match_type')?.value,
      team_a_name: teamA,
      team_b_name: teamB,
      max_sets: parseInt(document.getElementById('max_sets')?.value ?? '3'),
      match_label: document.getElementById('match_label')?.value.trim() || null,
      serving: servingSelected,
      status: 'waiting',
    }).select().single();

    if (error) { showToast('Errore: ' + error.message, 'error'); return; }
    match = data;
    history = [];
    showToast('Partita creata!');
    render();
  });

  // ── Partita esistente ──
  document.getElementById('start-match')?.addEventListener('click', async () => {
    await updateMatch({ status: 'live' });
  });

  document.getElementById('finish-match')?.addEventListener('click', async () => {
    if (!confirm('Terminare la partita?')) return;
    await updateMatch({ status: 'finished' });
  });

  document.getElementById('delete-match')?.addEventListener('click', async () => {
    if (!confirm('Eliminare la partita? L\'azione è irreversibile.')) return;
    await sb.from('live_score').delete().eq('id', match.id);
    match = null;
    history = [];
    showToast('Partita eliminata.');
    render();
  });

  document.getElementById('toggle-serve')?.addEventListener('click', async () => {
    await updateMatch({ serving: match.serving === 'a' ? 'b' : 'a' });
  });

  document.getElementById('point-a')?.addEventListener('click', () => addPoint('a'));
  document.getElementById('point-b')?.addEventListener('click', () => addPoint('b'));

  document.getElementById('undo-point')?.addEventListener('click', async () => {
    if (!history.length) { showToast('Nessun punto da annullare', 'error'); return; }
    const prev = history.pop();
    const { error } = await sb.from('live_score').update(prev).eq('id', match.id);
    if (error) { showToast('Errore annullamento: ' + error.message, 'error'); return; }
    match = { ...match, ...prev };
    showToast('Punto annullato ↩');
    render();
  });
}

// ─── Logica punti tennis/padel ────────────────────────────────────────────────

async function addPoint(who) {
  if (match.status === 'finished') return;

  // Salva snapshot per undo
  history.push({
    points_a: match.points_a,
    points_b: match.points_b,
    games_a: match.games_a,
    games_b: match.games_b,
    sets: match.sets,
    current_set: match.current_set,
    serving: match.serving,
    status: match.status,
    winner: match.winner,
  });
  if (history.length > 50) history.shift();

  let { points_a, points_b, games_a, games_b, sets, current_set, serving, status, winner } = match;
  const setsToWin = Math.ceil(match.max_sets / 2);

  // Deuce / vantaggio
  const isTiebreak = games_a === 6 && games_b === 6; // semplificato: tiebreak a 6-6

  let gameWon = false;
  let gameWinner = null;

  if (isTiebreak) {
    // Tiebreak: primo a 7 con 2 di vantaggio
    if (who === 'a') points_a++;
    else points_b++;

    if ((points_a >= 7 || points_b >= 7) && Math.abs(points_a - points_b) >= 2) {
      gameWon = true;
      gameWinner = points_a > points_b ? 'a' : 'b';
      points_a = 0; points_b = 0;
    }
  } else {
    // Normale: 0-15-30-40-vantaggio
    if (who === 'a') {
      if (points_a === 3 && points_b === 3) { points_a = 4; } // vantaggio A
      else if (points_b === 4) { points_b = 3; points_a = 3; } // tolto vantaggio B
      else { points_a++; }
    } else {
      if (points_b === 3 && points_a === 3) { points_b = 4; } // vantaggio B
      else if (points_a === 4) { points_a = 3; points_b = 3; } // tolto vantaggio A
      else { points_b++; }
    }

    // Verifica vittoria game
    if (points_a >= 4 || points_b >= 4) {
      gameWon = true;
      gameWinner = points_a >= 4 ? 'a' : 'b';
      points_a = 0; points_b = 0;
    }
  }

  // Vittoria game → aggiorna games
  if (gameWon) {
    if (gameWinner === 'a') games_a++;
    else games_b++;

    // Cambia servizio dopo ogni game (e dopo ogni 2 punti nel tiebreak - semplificato)
    serving = serving === 'a' ? 'b' : 'a';

    // Vittoria set?
    const setWon = checkSetWon(games_a, games_b, isTiebreak);
    if (setWon) {
      sets = [...(sets ?? []), { a: games_a, b: games_b }];
      games_a = 0; games_b = 0;
      current_set++;

      // Vittoria partita?
      const setsWonA = sets.filter(s => s.a > s.b).length;
      const setsWonB = sets.filter(s => s.b > s.a).length;
      if (setsWonA >= setsToWin || setsWonB >= setsToWin) {
        winner = setsWonA >= setsToWin ? 'a' : 'b';
        status = 'finished';
        showToast(`🏆 Vince ${winner === 'a' ? match.team_a_name : match.team_b_name}!`);
      }
    }
  }

  await updateMatch({ points_a, points_b, games_a, games_b, sets, current_set, serving, status, winner });
}

function checkSetWon(ga, gb, wasTiebreak) {
  // Vince il set chi arriva a 6 con 2 di vantaggio, oppure con tiebreak
  if (ga >= 6 && ga - gb >= 2) return true;
  if (gb >= 6 && gb - ga >= 2) return true;
  // Tiebreak vinto
  if (wasTiebreak && (ga === 7 || gb === 7)) return true;
  return false;
}

async function updateMatch(updates) {
  const { data, error } = await sb.from('live_score').update(updates).eq('id', match.id).select().single();
  if (error) { showToast('Errore: ' + error.message, 'error'); return; }
  match = data;
  render();
}

// ─── Init ────────────────────────────────────────────────────────────────────

render();
</script>
