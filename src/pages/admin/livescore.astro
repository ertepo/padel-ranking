---
import { supabase } from "../../lib/supabase";
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";

const adminPassword = Astro.cookies.get("admin_password");

if (adminPassword?.value !== import.meta.env.ADMIN_PASSWORD) {
    const redirectTo = encodeURIComponent(Astro.url.pathname);
    return Astro.redirect(`/login?redirect=${redirectTo}`);
}

const { data: activeMatch } = await supabase
    .from("live_score")
    .select("*")
    .in("status", ["live", "waiting"])
    .order("created_at", { ascending: false })
    .limit(1)
    .single();
---

<Layout title="Admin Live Score">
    <section class="mb-8">
        <p class="text-sm uppercase tracking-widest font-black text-slate-600">
            Area riservata
        </p>
        <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
            Live Score
        </h1>
        <p class="mt-4 max-w-xl text-slate-700 font-medium">
            Gestisci la partita in diretta. I punti vengono trasmessi in tempo reale.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
            <a href="/admin/tennis" class="club-btn px-5 py-3">← Admin Tennis</a>
            <a href="/livescore" target="_blank" class="club-btn px-5 py-3">👁 Apri vista pubblica</a>
        </div>
    </section>

    <div id="livescore-admin" data-match={JSON.stringify(activeMatch ?? null)}></div>
</Layout>

<script>
    import { createClient } from "@supabase/supabase-js";

    const sb = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    );

    const POINT_LABELS = ["0", "15", "30", "40"];

    function formatPoints(match) {
        if (match.games_a === 6 && match.games_b === 6) {
            return { a: String(match.points_a), b: String(match.points_b) };
        }
        const a = match.points_a;
        const b = match.points_b;
        if (a >= 3 && b >= 3) {
            if (a === b) return { a: "40", b: "40" };
            if (a > b) return { a: "Van", b: "-" };
            return { a: "-", b: "Van" };
        }
        return { a: POINT_LABELS[a] ?? "0", b: POINT_LABELS[b] ?? "0" };
    }

    function showToast(msg, type = "ok") {
        const t = document.createElement("div");
        t.className = `fixed top-6 right-6 z-[9999] border-2 border-black px-6 py-4 font-black text-lg transition-all duration-500 ${type === "error" ? "bg-rose-400" : "bg-emerald-400"}`;
        t.style.boxShadow = "6px 6px 0 black";
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(() => { t.style.opacity = "0"; t.style.transform = "translateX(120%)"; }, 2000);
        setTimeout(() => t.remove(), 2600);
    }

    const container = document.getElementById("livescore-admin");
    let match = JSON.parse(container?.dataset.match ?? "null");

    function render() {
        if (!container) return;
        container.innerHTML = match ? renderMatch() : renderNewMatch();
        attachEvents();
    }

    function renderNewMatch() {
        return `
        <div class="club-card p-6 max-w-2xl">
            <h2 class="text-2xl font-black mb-6">Nuova partita</h2>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="text-xs font-black uppercase tracking-widest text-slate-500">Sport</label>
                    <select id="sport" class="w-full border-2 border-black p-2 font-bold mt-1">
                        <option value="tennis">🎾 Tennis</option>
                        <option value="padel">🏓 Padel</option>
                    </select>
                </div>
                <div>
                    <label class="text-xs font-black uppercase tracking-widest text-slate-500">Tipo</label>
                    <select id="match_type" class="w-full border-2 border-black p-2 font-bold mt-1">
                        <option value="singles">Singolo</option>
                        <option value="doubles">Doppio</option>
                    </select>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="text-xs font-black uppercase tracking-widest text-slate-500">Giocatore / Team A</label>
                    <input id="team_a" type="text" placeholder="Es. Marco" class="w-full border-2 border-black p-2 font-bold mt-1" />
                </div>
                <div>
                    <label class="text-xs font-black uppercase tracking-widest text-slate-500">Giocatore / Team B</label>
                    <input id="team_b" type="text" placeholder="Es. Luca" class="w-full border-2 border-black p-2 font-bold mt-1" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="text-xs font-black uppercase tracking-widest text-slate-500">Numero set</label>
                    <select id="max_sets" class="w-full border-2 border-black p-2 font-bold mt-1">
                        <option value="3">Al meglio di 3</option>
                        <option value="5">Al meglio di 5</option>
                    </select>
                </div>
                <div>
                    <label class="text-xs font-black uppercase tracking-widest text-slate-500">Regola 40 pari</label>
                    <select id="golden_point" class="w-full border-2 border-black p-2 font-bold mt-1">
                        <option value="false">Vantaggi</option>
                        <option value="true">Punto de oro</option>
                    </select>
                </div>
            </div>
            <div class="mb-4">
                <label class="text-xs font-black uppercase tracking-widest text-slate-500">Etichetta partita (opz.)</label>
                <input id="match_label" type="text" placeholder="Es. Semifinale" class="w-full border-2 border-black p-2 font-bold mt-1" />
            </div>
            <div class="mb-6">
                <label class="text-xs font-black uppercase tracking-widest text-slate-500">Chi serve per primo?</label>
                <div class="flex gap-3 mt-2">
                    <button class="club-btn px-5 py-2 bg-green-200" id="serve-a">Team A serve</button>
                    <button class="club-btn px-5 py-2 bg-yellow-100" id="serve-b">Team B serve</button>
                </div>
                <p id="serve-hint" class="text-sm text-slate-500 mt-1">Nessuno selezionato</p>
            </div>
            <button id="create-match" class="club-btn w-full p-4 text-xl bg-blue-200">
                ▶ Crea partita
            </button>
        </div>`;
    }

    function renderMatch() {
        const sets = match.sets ?? [];
        const pts = formatPoints(match);
        const setsToWin = Math.ceil(match.max_sets / 2);
        const setsA = sets.filter((s) => s.a > s.b).length;
        const setsB = sets.filter((s) => s.b > s.a).length;
        const statusLabel = { waiting: "In attesa", live: "Live", finished: "Terminata" }[match.status] ?? match.status;
        const servingA = match.serving === "a";
        const servingB = match.serving === "b";

        const setPills = sets.map((s, i) =>
            `<span class="border-2 border-black px-3 py-1 text-sm font-black ${s.a > s.b ? "bg-green-200" : "bg-white"}">Set ${i + 1}: ${s.a}–${s.b}</span>`
        ).join("");

        return `
        <div class="max-w-2xl">
            <!-- Header -->
            <div class="club-card p-5 mb-4">
                <div class="flex items-center gap-3 flex-wrap mb-2">
                    <span class="border-2 border-black px-3 py-1 text-xs font-black uppercase tracking-widest ${match.status === "live" ? "bg-yellow-300" : match.status === "finished" ? "bg-green-200" : "bg-slate-200"}">
                        ${statusLabel}
                    </span>
                    <span class="font-bold">${match.sport === "padel" ? "🏓" : "🎾"} ${match.match_type === "doubles" ? "Doppio" : "Singolo"}</span>
                    ${match.match_label ? `<span class="text-slate-500 italic font-medium">${match.match_label}</span>` : ""}
                </div>
                <p class="text-sm text-slate-500">Set: ${setsA}–${setsB} (vince a ${setsToWin})</p>
                ${sets.length ? `<div class="flex gap-2 flex-wrap mt-2">${setPills}</div>` : ""}
            </div>

            <!-- Score -->
            <div class="club-card p-5">
                <div class="grid grid-cols-3 items-center text-center border-2 border-black bg-slate-50 p-4 mb-4">
                    <div>
                        <div class="font-black text-lg">
                            ${servingA ? '<span class="inline-block w-3 h-3 rounded-full bg-green-500 border-2 border-black mr-1 align-middle"></span>' : ""}
                            ${match.team_a_name}
                        </div>
                        <div class="text-7xl font-black leading-none text-green-600 my-2">${pts.a}</div>
                        <div class="text-2xl font-black text-slate-400">${match.games_a} game</div>
                    </div>
                    <div class="text-2xl font-black text-slate-300">VS</div>
                    <div>
                        <div class="font-black text-lg">
                            ${servingB ? '<span class="inline-block w-3 h-3 rounded-full bg-green-500 border-2 border-black mr-1 align-middle"></span>' : ""}
                            ${match.team_b_name}
                        </div>
                        <div class="text-7xl font-black leading-none text-yellow-500 my-2">${pts.b}</div>
                        <div class="text-2xl font-black text-slate-400">${match.games_b} game</div>
                    </div>
                </div>

                ${match.status !== "finished" ? `
                <!-- Pulsantoni punto -->
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <button id="point-a" class="club-btn p-8 text-2xl bg-green-200">
                        +1 punto<br/><span class="text-base opacity-60">${match.team_a_name}</span>
                    </button>
                    <button id="point-b" class="club-btn p-8 text-2xl bg-yellow-100">
                        +1 punto<br/><span class="text-base opacity-60">${match.team_b_name}</span>
                    </button>
                </div>
                <div class="grid grid-cols-2 gap-3 mb-4">
                    <button id="undo-point" class="club-btn px-4 py-3">↩ Annulla ultimo punto</button>
                    <button id="toggle-serve" class="club-btn px-4 py-3">⟳ Cambia servizio</button>
                </div>
                ` : `
                <div class="text-center py-4">
                    <p class="text-3xl font-black">🏆 Partita terminata!</p>
                    <p class="text-xl mt-2 font-bold">Vince: ${match.winner === "a" ? match.team_a_name : match.team_b_name}</p>
                </div>
                `}

                <div class="flex flex-wrap gap-3 pt-4 border-t-2 border-black">
                    ${match.status === "waiting" ? `<button class="club-btn px-5 py-3 bg-blue-200" id="start-match">▶ Inizia partita</button>` : ""}
                    ${match.status === "live" ? `<button class="club-btn px-5 py-3 bg-rose-200" id="finish-match">🏁 Termina partita</button>` : ""}
                    <button class="club-btn px-5 py-3 bg-rose-200" id="delete-match" style="margin-left:auto">🗑 Elimina</button>
                </div>
            </div>
        </div>`;
    }

    let servingSelected = "a";
    let history = [];

    function attachEvents() {
        const serveABtn = document.getElementById("serve-a");
        const serveBBtn = document.getElementById("serve-b");
        const serveHint = document.getElementById("serve-hint");

        serveABtn?.addEventListener("click", () => {
            servingSelected = "a";
            serveHint.textContent = "✅ Team A serve";
            serveABtn.style.outline = "3px solid black";
            serveBBtn.style.outline = "";
        });

        serveBBtn?.addEventListener("click", () => {
            servingSelected = "b";
            serveHint.textContent = "✅ Team B serve";
            serveBBtn.style.outline = "3px solid black";
            serveABtn.style.outline = "";
        });

        document.getElementById("create-match")?.addEventListener("click", async () => {
            const teamA = document.getElementById("team_a")?.value.trim();
            const teamB = document.getElementById("team_b")?.value.trim();
            if (!teamA || !teamB) { showToast("Inserisci i nomi dei giocatori", "error"); return; }

            const { data, error } = await sb.from("live_score").insert({
                sport: document.getElementById("sport")?.value,
                match_type: document.getElementById("match_type")?.value,
                team_a_name: teamA,
                team_b_name: teamB,
                max_sets: parseInt(document.getElementById("max_sets")?.value ?? "3"),
                match_label: document.getElementById("match_label")?.value.trim() || null,
                golden_point: document.getElementById("golden_point")?.value === "true",
                serving: servingSelected,
                status: "waiting",
            }).select().single();

            if (error) { showToast("Errore: " + error.message, "error"); return; }
            match = data;
            history = [];
            showToast("Partita creata!");
            render();
        });

        document.getElementById("start-match")?.addEventListener("click", async () => {
            await updateMatch({ status: "live" });
        });

        document.getElementById("finish-match")?.addEventListener("click", async () => {
            if (!confirm("Terminare la partita?")) return;
            const completedSets = match.sets ?? [];
            const setsWonA = completedSets.filter((s) => s.a > s.b).length;
            const setsWonB = completedSets.filter((s) => s.b > s.a).length;
            let finalWinner = null;
            if (setsWonA > setsWonB) finalWinner = "a";
            else if (setsWonB > setsWonA) finalWinner = "b";
            else finalWinner = match.games_a >= match.games_b ? "a" : "b";
            await updateMatch({ status: "finished", winner: finalWinner });
        });

        document.getElementById("delete-match")?.addEventListener("click", async () => {
            if (!confirm("Eliminare la partita? L'azione è irreversibile.")) return;
            await sb.from("live_score").delete().eq("id", match.id);
            match = null;
            history = [];
            showToast("Partita eliminata.");
            render();
        });

        document.getElementById("toggle-serve")?.addEventListener("click", async () => {
            await updateMatch({ serving: match.serving === "a" ? "b" : "a" });
        });

        document.getElementById("point-a")?.addEventListener("click", () => addPoint("a"));
        document.getElementById("point-b")?.addEventListener("click", () => addPoint("b"));

        document.getElementById("undo-point")?.addEventListener("click", async () => {
            if (!history.length) { showToast("Nessun punto da annullare", "error"); return; }
            const prev = history.pop();
            const { error } = await sb.from("live_score").update(prev).eq("id", match.id);
            if (error) { showToast("Errore annullamento: " + error.message, "error"); return; }
            match = { ...match, ...prev };
            showToast("Punto annullato ↩");
            render();
        });
    }

    async function addPoint(who) {
        if (match.status === "finished") return;

        history.push({
            points_a: match.points_a,
            points_b: match.points_b,
            games_a: match.games_a,
            games_b: match.games_b,
            sets: match.sets,
            current_set: match.current_set,
            serving: match.serving,
            status: match.status,
            winner: match.winner,
        });
        if (history.length > 50) history.shift();

        let { points_a, points_b, games_a, games_b, sets, current_set, serving, status, winner } = match;
        const setsToWin = Math.ceil(match.max_sets / 2);
        const isTiebreak = games_a === 6 && games_b === 6;
        const goldenPoint = match.golden_point;

        let gameWon = false;
        let gameWinner = null;

        if (isTiebreak) {
            if (who === "a") points_a++;
            else points_b++;

            const totalPoints = points_a + points_b;
            if (totalPoints === 1 || (totalPoints > 1 && totalPoints % 2 === 1)) {
                serving = serving === "a" ? "b" : "a";
            }

            if ((points_a >= 7 || points_b >= 7) && Math.abs(points_a - points_b) >= 2) {
                gameWon = true;
                gameWinner = points_a > points_b ? "a" : "b";
                if (gameWinner === "a") games_a++;
                else games_b++;
                points_a = 0;
                points_b = 0;
            }
        } else {
            if (who === "a") points_a++;
            else points_b++;

            if (goldenPoint) {
                if (points_a >= 4 || points_b >= 4) {
                    gameWon = true;
                    gameWinner = points_a > points_b ? "a" : "b";
                }
            } else {
                if ((points_a >= 4 || points_b >= 4) && Math.abs(points_a - points_b) >= 2) {
                    gameWon = true;
                    gameWinner = points_a > points_b ? "a" : "b";
                }
            }

            if (gameWon) {
                points_a = 0;
                points_b = 0;
            }
        }

        if (gameWon) {
            if (gameWinner === "a") games_a++;
            else games_b++;

            if (!isTiebreak) serving = serving === "a" ? "b" : "a";

            const setWon =
                ((games_a >= 6 || games_b >= 6) && Math.abs(games_a - games_b) >= 2) ||
                (games_a === 7 && games_b === 6) ||
                (games_b === 7 && games_a === 6);

            if (setWon) {
                sets = [...(sets ?? []), { a: games_a, b: games_b }];
                games_a = 0;
                games_b = 0;
                current_set++;

                const setsWonA = sets.filter((s) => s.a > s.b).length;
                const setsWonB = sets.filter((s) => s.b > s.a).length;
                if (setsWonA >= setsToWin || setsWonB >= setsToWin) {
                    winner = setsWonA >= setsToWin ? "a" : "b";
                    status = "finished";
                    showToast(`🏆 Vince ${winner === "a" ? match.team_a_name : match.team_b_name}!`);
                }
            }
        }

        await updateMatch({ points_a, points_b, games_a, games_b, sets, current_set, serving, status, winner });
    }

    async function updateMatch(updates) {
        const { data, error } = await sb
            .from("live_score")
            .update(updates)
            .eq("id", match.id)
            .select()
            .single();
        if (error) { showToast("Errore: " + error.message, "error"); return; }
        match = data;
        render();
    }

    render();
</script>