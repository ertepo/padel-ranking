---
// CORRETTO: Aggiunto un livello di uscita (../) perché ora siamo dentro la sottocartella admin/
import { supabase } from '../../lib/supabase';
import { calculateEloChange } from '../../lib/elo';
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';

const adminPassword = Astro.cookies.get('admin_password');

if (adminPassword?.value !== import.meta.env.ADMIN_PASSWORD) {
  return Astro.redirect('/login');
}

const { data: players } = await supabase
  .from('players')
  .select('*')
  .order('name');

let message = '';

if (Astro.url.searchParams.get('saved') === '1') {
  message = 'Match salvato correttamente!';
}

if (Astro.request.method === 'POST') {
  const body = await Astro.request.text();
  console.log('BODY RICEVUTO:', body);

  const data = new URLSearchParams(body);

  // 1. Recuperiamo i NOMI inseriti nei campi autocomplete
  const a1Name = data.get('a1_name')?.trim() || '';
  const a2Name = data.get('a2_name')?.trim() || '';
  const b1Name = data.get('b1_name')?.trim() || '';
  const b2Name = data.get('b2_name')?.trim() || '';
  const winner = (data.get('winner') || '') as 'A' | 'B';
  const score = data.get('score') || '';

  // Controllo iniziale sui dati del form
  if (!a1Name || !a2Name || !b1Name || !b2Name || !winner) {
    throw new Error('Errore: alcuni campi del form non sono stati inviati correttamente.');
  }

  const inputNames = [a1Name, a2Name, b1Name, b2Name];
  
  // Rilevamento dei duplicati funzionante
  if (new Set(inputNames).size !== 4) {
    throw new Error('Errore: hai inserito lo stesso giocatore in più posizioni.');
  }

  // 2. Cerchiamo i giocatori nel DB basandoci sulla lista dei nomi esatti
  const { data: selectedPlayers, error: fetchError } = await supabase
    .from('players')
    .select('*')
    .in('name', inputNames);

  // Se non trova esattamente 4 giocatori, cerchiamo di capire perché
  if (fetchError || !selectedPlayers || selectedPlayers.length !== 4) {
    console.error("Giocatori trovati nel DB:", selectedPlayers, "Errore:", fetchError);
    throw new Error('Errore: Uno o più nomi inseriti non sono registrati nel database. Assicurati di selezionarli dal menu o di scriverli identici (rispettando maiuscole/minuscole).');
  }

  // Associazioni degli ID basandoci sul confronto dei nomi
  const a1 = selectedPlayers.find(p => p.name === a1Name)?.id || '';
  const a2 = selectedPlayers.find(p => p.name === a2Name)?.id || '';
  const b1 = selectedPlayers.find(p => p.name === b1Name)?.id || '';
  const b2 = selectedPlayers.find(p => p.name === b2Name)?.id || '';

  const teamA = selectedPlayers.filter(p => p.id === a1 || p.id === a2);
  const teamB = selectedPlayers.filter(p => p.id === b1 || p.id === b2);

  if (teamA.length !== 2 || teamB.length !== 2) {
    throw new Error('Errore nella divisione delle squadre. Controlla i nomi inseriti.');
  }

  const avgA = (teamA[0].current_elo + teamA[1].current_elo) / 2;
  const avgB = (teamB[0].current_elo + teamB[1].current_elo) / 2;

  // Calcolo Elo standard
  const elo = calculateEloChange(avgA, avgB, winner);

  const winners = winner === 'A' ? teamA : teamB;
  const losers = winner === 'A' ? teamB : teamA;

  // 1. INSERIMENTO DEL MATCH NELLA TABELLA PRINCIPALE
  const { data: insertedMatch, error: matchError } = await supabase
    .from('matches')
    .insert({
      winner_team: winner,
      score,
      team_a_avg_elo: avgA,
      team_b_avg_elo: avgB,
      match_type: elo.matchType,
      elo_delta_winner: elo.winnerDelta,
      elo_delta_loser: elo.loserDelta,
    })
    .select()
    .single();
  
  if (matchError) {
    throw new Error(matchError.message);
  }

  // 2. AGGIORNAMENTO CLASSIFICA VINCITORI (TABELLA PLAYERS)
  for (const player of winners) {
    const playerDelta = player.matches_played < 3 ? 15 : elo.winnerDelta;
    await supabase
      .from('players')
      .update({
        current_elo: player.current_elo + playerDelta,
        matches_played: player.matches_played + 1,
        wins: player.wins + 1,
      })
      .eq('id', player.id);
  }

  // 3. AGGIORNAMENTO CLASSIFICA PERDENTI (TABELLA PLAYERS)
  for (const player of losers) {
    const playerDelta = player.matches_played < 3 ? -15 : elo.loserDelta;
    await supabase
      .from('players')
      .update({
        current_elo: player.current_elo + playerDelta,
        matches_played: player.matches_played + 1,
        losses: player.losses + 1,
      })
      .eq('id', player.id);
  }

  // 4. INSERIMENTO STORICO INDIVIDUALE VINCITORI (TABELLA MATCH_PLAYERS)
  for (const player of winners) {
    const playerDelta = player.matches_played < 3 ? 15 : elo.winnerDelta;
    await supabase
      .from('match_players')
      .insert({
        match_id: insertedMatch.id,
        player_id: player.id,
        team: winner === 'A' ? (teamA.some(p => p.id === player.id) ? 'A' : 'B') : (teamB.some(p => p.id === player.id) ? 'B' : 'A'),
        elo_before: player.current_elo,
        elo_after: player.current_elo + playerDelta,
        delta: playerDelta,
        result: 'win',
      });
  }

  // 5. INSERIMENTO STORICO INDIVIDUALE PERDENTI (TABELLA MATCH_PLAYERS)
  for (const player of losers) {
    const playerDelta = player.matches_played < 3 ? -15 : elo.loserDelta;
    await supabase
      .from('match_players')
      .insert({
        match_id: insertedMatch.id,
        player_id: player.id,
        team: winner === 'A' ? (teamB.some(p => p.id === player.id) ? 'B' : 'A') : (teamA.some(p => p.id === player.id) ? 'A' : 'B'),
        elo_before: player.current_elo,
        elo_after: player.current_elo + playerDelta,
        delta: playerDelta,
        result: 'loss',
      });
  }

  // CORRETTO: Ora reindirizza alla nuova rotta /admin/padel
  return Astro.redirect('/admin/padel?saved=1');
}
---

<Layout title="Admin Padel">
  <datalist id="players-list">
    {players?.map(player => (
      <option value={player.name}></option>
    ))}
  </datalist>

  <section class="mb-8">
    <p class="text-sm uppercase tracking-widest font-black text-slate-600">
      Area riservata
    </p>
    <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
      Admin Padel
    </h1>
    <p class="mt-4 max-w-xl text-slate-700 font-medium">
      Inserisci un nuovo match ranking e aggiorna automaticamente la classifica ELO del torneo di Padel.
    </p>
  </section>

  {message && (
    <div id="success-banner" class="club-card bg-emerald-500 text-white p-4 mb-6 font-black">
      {message}
    </div>
  )}

  {/* CORRETTO: action puntata sulla rotta corretta /admin/padel */}
  <form method="POST" action="/admin/padel" class="club-card p-5 md:p-6 max-w-2xl space-y-8">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-black text-white px-3 py-1 font-black text-sm">A</span>
        <h2 class="text-2xl font-black text-black">Team A</h2>
      </div>
      <div class="grid gap-3 md:grid-cols-2">
        <input 
          type="text" 
          name="a1_name" 
          list="players-list" 
          placeholder="Cerca giocatore A1..." 
          required 
          autocomplete="off"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />
        <input 
          type="text" 
          name="a2_name" 
          list="players-list" 
          placeholder="Cerca giocatore A2..." 
          required 
          autocomplete="off"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="h-1 bg-black flex-1"></div>
      <span class="bg-black text-white px-4 py-2 font-black uppercase text-sm">vs</span>
      <div class="h-1 bg-black flex-1"></div>
    </div>

    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-[var(--giallo-club)] border-2 border-black text-black px-3 py-1 font-black text-sm">B</span>
        <h2 class="text-2xl font-black text-black">Team B</h2>
      </div>
      <div class="grid gap-3 md:grid-cols-2">
        <input 
          type="text" 
          name="b1_name" 
          list="players-list" 
          placeholder="Cerca giocatore B1..." 
          required 
          autocomplete="off"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />
        <input 
          type="text" 
          name="b2_name" 
          list="players-list" 
          placeholder="Cerca giocatore B2..." 
          required 
          autocomplete="off"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-black mb-3 text-black">Vincitore</h2>
        <select name="winner" required class="w-full border-2 border-black bg-white p-3 font-bold">
          <option value="A">Team A</option>
          <option value="B">Team B</option>
        </select>
      </div>

      <div>
        <h2 class="text-2xl font-black mb-3 text-black">Risultato</h2>
        <input
          type="text"
          name="score"
          placeholder="6-4 6-3"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />
      </div>
    </div>

    <button type="submit" class="club-btn w-full p-4 text-xl">
      Salva Match Padel
    </button>
  </form>

  <script is:inline>
    const banner = document.getElementById('success-banner');
    if (banner) {
      setTimeout(() => {
        banner.remove();
        const url = new URL(window.location);
        url.searchParams.delete('saved');
        window.history.replaceState({}, '', url);
      }, 3000);
    }
  </script>
</Layout>