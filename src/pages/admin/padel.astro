---
import { getSupabaseAdmin } from "../../lib/supabaseAdmin";
import { calculateEloChange } from "../../lib/elo";
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";

const adminPassword = Astro.cookies.get("admin_password");

if (adminPassword?.value !== import.meta.env.ADMIN_PASSWORD) {
    const redirectTo = encodeURIComponent(Astro.url.pathname);
    return Astro.redirect(`/login?redirect=${redirectTo}`);
}

const supabase = getSupabaseAdmin();

// Recupera SOLO i giocatori iscritti al padel con i relativi dati anagrafici
const { data: players } = await supabase
    .from("padel_rankings")
    .select(
        `
    player_id,
    current_elo,
    matches_played,
    wins,
    losses,
    players (
      id,
      name
    )
  `,
    )
    .order("current_elo", { ascending: false });

// Recupera lo storico coppie per suggerire l'ultimo compagno di squadra
const { data: matchPlayerRows } = await supabase
    .from("match_players")
    .select("match_id, player_id, team, matches!inner(created_at)")
    .order("created_at", { referencedTable: "matches", ascending: false });

const matchTeams = new Map<string, { A: string[]; B: string[] }>();
const matchOrder = new Map<string, string>();

for (const row of matchPlayerRows ?? []) {
    const matchId = row.match_id as string;
    const createdAt = (row.matches as any)?.created_at;

    if (createdAt && !matchOrder.has(matchId)) {
        matchOrder.set(matchId, createdAt);
    }

    if (!matchTeams.has(matchId)) {
        matchTeams.set(matchId, { A: [], B: [] });
    }

    const team = row.team as "A" | "B";
    matchTeams.get(matchId)?.[team]?.push(row.player_id as string);
}

const orderedMatchIds = [...matchOrder.entries()]
    .sort((a, b) => new Date(b[1]).getTime() - new Date(a[1]).getTime())
    .map(([matchId]) => matchId);

const lastPartnerByPlayer: Record<string, string> = {};

for (const matchId of orderedMatchIds) {
    const teams = matchTeams.get(matchId);

    for (const team of [teams?.A, teams?.B]) {
        if (!team || team.length !== 2) continue;

        const [p1, p2] = team;

        if (!(p1 in lastPartnerByPlayer)) lastPartnerByPlayer[p1] = p2;
        if (!(p2 in lastPartnerByPlayer)) lastPartnerByPlayer[p2] = p1;
    }
}

let message = "";
let errorMessage = "";

if (Astro.url.searchParams.get("saved") === "1") {
    message = "Match salvato correttamente!";
}

if (Astro.request.method === "POST") {
    try {
        const body = await Astro.request.text();
        const data = new URLSearchParams(body);

        // 1. Recuperiamo gli ID (UUID) inviati dalle select invece dei nomi
        const a1Id = data.get("a1_id")?.trim() || "";
        const a2Id = data.get("a2_id")?.trim() || "";
        const b1Id = data.get("b1_id")?.trim() || "";
        const b2Id = data.get("b2_id")?.trim() || "";
        const winner = (data.get("winner") || "") as "A" | "B";
        const score = data.get("score")?.trim() || "";
        const note = data.get("note")?.trim() || null;
        const bestPlayerId = data.get("best_player_id")?.trim() || null;

        if (!a1Id || !a2Id || !b1Id || !b2Id || !winner) {
            throw new Error("Compila tutti i campi.");
        }

        const inputIds = [a1Id, a2Id, b1Id, b2Id];

        if (bestPlayerId && !inputIds.includes(bestPlayerId)) {
            throw new Error("Il best player deve essere uno dei giocatori del match.");
        }

        // Controllo duplicati basato sugli ID univoci
        if (new Set(inputIds).size !== 4) {
            throw new Error("Hai inserito lo stesso giocatore più volte.");
        }

        // Recuperiamo TUTTI i giocatori padel dal database
        const { data: allPlayers, error: fetchError } = await supabase.from(
            "padel_rankings",
        ).select(`
        player_id,
        current_elo,
        matches_played,
        wins,
        losses,
        players (
          id,
          name
        )
      `);

        if (fetchError || !allPlayers) {
            throw new Error("Errore nel recupero dei giocatori.");
        }

        // 2. Filtriamo i 4 giocatori selezionati confrontando direttamente il loro player_id (UUID)
        const selectedPlayers = allPlayers.filter((p) =>
            inputIds.includes(p.player_id),
        );

        if (selectedPlayers.length !== 4) {
            throw new Error("Uno o più giocatori non esistono nel database.");
        }

        // 3. Associazione dei singoli giocatori tramite l'ID
        const a1 = selectedPlayers.find((p) => p.player_id === a1Id);
        const a2 = selectedPlayers.find((p) => p.player_id === a2Id);
        const b1 = selectedPlayers.find((p) => p.player_id === b1Id);
        const b2 = selectedPlayers.find((p) => p.player_id === b2Id);

        if (!a1 || !a2 || !b1 || !b2) {
            throw new Error("Errore nella selezione giocatori.");
        }

        const teamA = [a1, a2];
        const teamB = [b1, b2];

        const avgA = (teamA[0].current_elo + teamA[1].current_elo) / 2;
        const avgB = (teamB[0].current_elo + teamB[1].current_elo) / 2;

        // Calcolo ELO
        const elo = calculateEloChange(avgA, avgB, winner);

        const winners = winner === "A" ? teamA : teamB;
        const losers = winner === "A" ? teamB : teamA;

        // Inserimento del match principale
        const { data: insertedMatch, error: matchError } = await supabase
            .from("matches")
            .insert({
                winner_team: winner,
                score,
                team_a_avg_elo: avgA,
                team_b_avg_elo: avgB,
                match_type: elo.matchType,
                elo_delta_winner: elo.winnerDelta,
                elo_delta_loser: elo.loserDelta,
                note,
                best_player_id: bestPlayerId,
            })
            .select()
            .single();

        if (matchError || !insertedMatch) {
            throw new Error(matchError?.message);
        }

        // UPDATE VINCITORI
        for (const player of winners) {
            const playerDelta =
                player.matches_played < 3 ? 15 : elo.winnerDelta;
            await supabase
                .from("padel_rankings")
                .update({
                    current_elo: player.current_elo + playerDelta,
                    matches_played: player.matches_played + 1,
                    wins: player.wins + 1,
                })
                .eq("player_id", player.player_id);
        }

        // UPDATE PERDENTI
        for (const player of losers) {
            const playerDelta =
                player.matches_played < 3 ? -15 : elo.loserDelta;
            await supabase
                .from("padel_rankings")
                .update({
                    current_elo: player.current_elo + playerDelta,
                    matches_played: player.matches_played + 1,
                    losses: player.losses + 1,
                })
                .eq("player_id", player.player_id);
        }

        // Storico vincitori
        for (const player of winners) {
            const playerDelta =
                player.matches_played < 3 ? 15 : elo.winnerDelta;
            await supabase.from("match_players").insert({
                match_id: insertedMatch.id,
                player_id: player.player_id,
                team: winner === "A" ? "A" : "B",
                elo_before: player.current_elo,
                elo_after: player.current_elo + playerDelta,
                delta: playerDelta,
                result: "win",
            });
        }

        // Storico perdenti
        for (const player of losers) {
            const playerDelta =
                player.matches_played < 3 ? -15 : elo.loserDelta;
            await supabase.from("match_players").insert({
                match_id: insertedMatch.id,
                player_id: player.player_id,
                team: winner === "A" ? "B" : "A",
                elo_before: player.current_elo,
                elo_after: player.current_elo + playerDelta,
                delta: playerDelta,
                result: "loss",
            });
        }

        return Astro.redirect("/admin/padel?saved=1");
    } catch (err: any) {
        console.log(err);
        errorMessage = err.message || "Errore sconosciuto";
    }
}
---

<Layout title="Admin Padel" noindex={true} headerTheme="padel">
    <section class="mb-8">
        <p class="text-sm uppercase tracking-widest font-black text-slate-600">
            Area riservata
        </p>

        <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
            Admin Padel
        </h1>

        <p class="mt-4 max-w-xl text-slate-700 font-medium">
            Inserisci un nuovo match ranking e aggiorna automaticamente la
            classifica ELO del torneo di Padel.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
            <a href="/admin/players" class="club-btn-pastelyellow px-5 py-3">
                Gestisci Giocatori
            </a>

            <a href="/admin/tennis" class="club-btn px-5 py-3">
                Vai ad Admin Tennis
            </a>
        </div>
    </section>

    {
        message && (
            <div
                id="success-banner"
                class="fixed top-6 right-6 z-[9999] bg-emerald-500 text-black px-6 py-4 border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] font-black text-lg transition-all duration-700"
            >
                {message}
            </div>
        )
    }
    {
        errorMessage && (
            <div
                id="error-banner"
                class="fixed top-6 right-6 z-[9999] bg-rose-500 text-white px-6 py-4 border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] font-black text-lg transition-all duration-700"
            >
                ⚠️ {errorMessage}
            </div>
        )
    }

    <form
        method="POST"
        action="/admin/padel"
        class="club-card p-5 md:p-6 max-w-2xl space-y-8 bg-white"
    >
        <div>
            <div class="flex items-center gap-3 mb-4">
                <span class="bg-black text-white px-3 py-1 font-black text-sm">
                    A
                </span>
                <h2 class="text-2xl font-black text-black">Team A</h2>
            </div>

            <div class="grid gap-3 md:grid-cols-2">
                <div>
                    <select
                        name="a1_id"
                        required
                        class="w-full border-2 border-black bg-white p-3 font-bold"
                    >
                        <option value="" disabled selected
                            >Seleziona Giocatore A1...</option
                        >
                        {
                            players?.map((player) => (
                                <option value={player.player_id}>
                                    {player.players.name} ({player.current_elo} ELO)
                                </option>
                            ))
                        }
                    </select>
                </div>

                <div>
                    <select
                        name="a2_id"
                        required
                        class="w-full border-2 border-black bg-white p-3 font-bold"
                    >
                        <option value="" disabled selected
                            >Seleziona Giocatore A2...</option
                        >
                        {
                            players?.map((player) => (
                                <option value={player.player_id}>
                                    {player.players.name} ({player.current_elo} ELO)
                                </option>
                            ))
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <div class="h-1 bg-black flex-1"></div>
            <span
                class="bg-black text-white px-4 py-2 font-black uppercase text-sm"
            >
                vs
            </span>
            <div class="h-1 bg-black flex-1"></div>
        </div>

        <div>
            <div class="flex items-center gap-3 mb-4">
                <span
                    class="bg-[var(--giallo-club)] border-2 border-black text-black px-3 py-1 font-black text-sm"
                >
                    B
                </span>
                <h2 class="text-2xl font-black text-black">Team B</h2>
            </div>

            <div class="grid gap-3 md:grid-cols-2">
                <div>
                    <select
                        name="b1_id"
                        required
                        class="w-full border-2 border-black bg-white p-3 font-bold"
                    >
                        <option value="" disabled selected
                            >Seleziona Giocatore B1...</option
                        >
                        {
                            players?.map((player) => (
                                <option value={player.player_id}>
                                    {player.players.name} ({player.current_elo} ELO)
                                </option>
                            ))
                        }
                    </select>
                </div>

                <div>
                    <select
                        name="b2_id"
                        required
                        class="w-full border-2 border-black bg-white p-3 font-bold"
                    >
                        <option value="" disabled selected
                            >Seleziona Giocatore B2...</option
                        >
                        {
                            players?.map((player) => (
                                <option value={player.player_id}>
                                    {player.players.name} ({player.current_elo} ELO)
                                </option>
                            ))
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
            <div>
                <h2 class="text-2xl font-black mb-3 text-black">Vincitore</h2>
                <select
                    name="winner"
                    required
                    class="w-full border-2 border-black bg-white p-3 font-bold"
                >
                    <option value="A">Team A</option>
                    <option value="B">Team B</option>
                </select>
            </div>

            <div>
                <h2 class="text-2xl font-black mb-3 text-black">Risultato</h2>
                <input
                    type="text"
                    name="score"
                    placeholder="6-4 6-3"
                    class="w-full border-2 border-black bg-white p-3 font-bold"
                />
            </div>
        </div>

        <div>
            <h2 class="text-2xl font-black mb-3 text-black">Nota partita</h2>
            <textarea
                name="note"
                rows="3"
                placeholder="Es. Citazione, sfotto, momento epico..."
                class="w-full border-2 border-black bg-white p-3 font-bold"
            ></textarea>
            <fieldset class="mt-5 border-2 border-black bg-[var(--giallo-club)] p-3">
                <legend class="px-2 text-sm font-black uppercase tracking-widest">
                    Best player del match
                </legend>

                <div class="grid gap-2">
                    <label class="flex items-center gap-3 border-2 border-black bg-white p-3 font-black">
                        <input type="radio" name="best_player_id" data-best-player-radio="a1_id" disabled />
                        <span data-best-player-label="a1_id">Seleziona Giocatore A1</span>
                    </label>

                    <label class="flex items-center gap-3 border-2 border-black bg-white p-3 font-black">
                        <input type="radio" name="best_player_id" data-best-player-radio="a2_id" disabled />
                        <span data-best-player-label="a2_id">Seleziona Giocatore A2</span>
                    </label>

                    <label class="flex items-center gap-3 border-2 border-black bg-white p-3 font-black">
                        <input type="radio" name="best_player_id" data-best-player-radio="b1_id" disabled />
                        <span data-best-player-label="b1_id">Seleziona Giocatore B1</span>
                    </label>

                    <label class="flex items-center gap-3 border-2 border-black bg-white p-3 font-black">
                        <input type="radio" name="best_player_id" data-best-player-radio="b2_id" disabled />
                        <span data-best-player-label="b2_id">Seleziona Giocatore B2</span>
                    </label>
                </div>
            </fieldset>
        </div>

        <button type="submit" class="club-btn w-full p-4 text-xl">
            Salva Match Padel
        </button>
    </form>

    <script is:inline define:vars={{ lastPartnerByPlayer }}>
        function setupBanner(id) {
            const banner = document.getElementById(id);

            if (!banner) return;

            setTimeout(() => {
                banner.style.transform = "translateX(150%)";
                banner.style.opacity = "0";
            }, 2200);

            setTimeout(() => {
                banner.remove();

                const url = new URL(window.location);

                url.searchParams.delete("saved");

                window.history.replaceState({}, "", url);
            }, 5000);
        }

        setupBanner("success-banner");
        setupBanner("error-banner");

        function syncBestPlayerRadio(selectName) {
            const select = document.querySelector(`[name="${selectName}"]`);
            const radio = document.querySelector(`[data-best-player-radio="${selectName}"]`);
            const label = document.querySelector(`[data-best-player-label="${selectName}"]`);

            if (!select || !radio || !label) return;

            if (!select.value) {
                radio.checked = false;
                radio.disabled = true;
                radio.value = "";
                label.textContent = select.options[0]?.text || "Seleziona giocatore";
                return;
            }

            radio.disabled = false;
            radio.value = select.value;
            label.textContent = select.options[select.selectedIndex].text;
        }

        ["a1_id", "a2_id", "b1_id", "b2_id"].forEach((selectName) => {
            const select = document.querySelector(`[name="${selectName}"]`);
            select?.addEventListener("change", () => syncBestPlayerRadio(selectName));
            syncBestPlayerRadio(selectName);
        });

        // Suggerimento automatico dell'ultimo compagno di squadra
        let suppressAutofillClear = false;

        function selectedIds() {
            return ["a1_id", "a2_id", "b1_id", "b2_id"]
                .map((name) => document.querySelector(`[name="${name}"]`)?.value)
                .filter(Boolean);
        }

        function setupPartnerSuggestion(sourceName, targetName) {
            const sourceSelect = document.querySelector(`[name="${sourceName}"]`);
            const targetSelect = document.querySelector(`[name="${targetName}"]`);

            if (!sourceSelect || !targetSelect) return;

            targetSelect.addEventListener("change", () => {
                if (suppressAutofillClear) return;
                targetSelect.dataset.autofilled = "0";
            });

            sourceSelect.addEventListener("change", () => {
                const sourceId = sourceSelect.value;

                if (!sourceId) return;

                const targetHasManualValue =
                    targetSelect.value && targetSelect.dataset.autofilled !== "1";

                if (targetHasManualValue) return;

                const suggestedId = lastPartnerByPlayer[sourceId];

                if (!suggestedId || selectedIds().includes(suggestedId)) return;

                const optionExists = [...targetSelect.options].some(
                    (option) => option.value === suggestedId,
                );

                if (!optionExists) return;

                suppressAutofillClear = true;
                targetSelect.value = suggestedId;
                targetSelect.dataset.autofilled = "1";
                targetSelect.dispatchEvent(new Event("change"));
                suppressAutofillClear = false;
            });
        }

        setupPartnerSuggestion("a1_id", "a2_id");
        setupPartnerSuggestion("b1_id", "b2_id");
    </script>
</Layout>
