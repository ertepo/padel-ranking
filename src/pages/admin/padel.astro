---
import { supabase } from '../../lib/supabase';
import { calculateEloChange } from '../../lib/elo';
import '../../styles/global.css';
import Layout from '../../layouts/Layout.astro';

const adminPassword = Astro.cookies.get('admin_password');

if (adminPassword?.value !== import.meta.env.ADMIN_PASSWORD) {
  return Astro.redirect('/login');
}

// Recupera SOLO i giocatori iscritti al padel
const { data: players } = await supabase
  .from('padel_rankings')
  .select(`
    player_id,
    current_elo,
    matches_played,
    wins,
    losses,
    players (
      id,
      name
    )
  `)
  .order('current_elo', { ascending: false });

let message = '';

if (Astro.url.searchParams.get('saved') === '1') {
  message = 'Match salvato correttamente!';
}

if (Astro.request.method === 'POST') {
  try {
    const body = await Astro.request.text();
    const data = new URLSearchParams(body);

    const a1Name = data.get('a1_name')?.trim() || '';
    const a2Name = data.get('a2_name')?.trim() || '';
    const b1Name = data.get('b1_name')?.trim() || '';
    const b2Name = data.get('b2_name')?.trim() || '';

    const winner = (data.get('winner') || '') as 'A' | 'B';
    const score = data.get('score') || '';

    if (!a1Name || !a2Name || !b1Name || !b2Name || !winner) {
      throw new Error('Compila tutti i campi.');
    }

    const inputNames = [a1Name, a2Name, b1Name, b2Name];

    // Controllo duplicati
    if (new Set(inputNames).size !== 4) {
      throw new Error('Hai inserito lo stesso giocatore più volte.');
    }

    // Recuperiamo TUTTI i giocatori padel
    const { data: allPlayers, error: fetchError } = await supabase
      .from('padel_rankings')
      .select(`
        player_id,
        current_elo,
        matches_played,
        wins,
        losses,
        players (
          id,
          name
        )
      `);

    if (fetchError || !allPlayers) {
      throw new Error('Errore nel recupero dei giocatori.');
    }

    // Filtra i 4 giocatori selezionati
    const selectedPlayers = allPlayers.filter(p =>
      inputNames.includes(p.players.name)
    );

    if (selectedPlayers.length !== 4) {
      throw new Error(
        'Uno o più giocatori non esistono nel database.'
      );
    }

    // Associazione giocatori
    const a1 = selectedPlayers.find(
      p => p.players.name === a1Name
    );

    const a2 = selectedPlayers.find(
      p => p.players.name === a2Name
    );

    const b1 = selectedPlayers.find(
      p => p.players.name === b1Name
    );

    const b2 = selectedPlayers.find(
      p => p.players.name === b2Name
    );

    if (!a1 || !a2 || !b1 || !b2) {
      throw new Error('Errore nella selezione giocatori.');
    }

    const teamA = [a1, a2];
    const teamB = [b1, b2];

    const avgA =
      (teamA[0].current_elo + teamA[1].current_elo) / 2;

    const avgB =
      (teamB[0].current_elo + teamB[1].current_elo) / 2;

    // Calcolo elo
    const elo = calculateEloChange(avgA, avgB, winner);

    const winners = winner === 'A' ? teamA : teamB;
    const losers = winner === 'A' ? teamB : teamA;

    // Inserimento match principale
    const { data: insertedMatch, error: matchError } =
      await supabase
        .from('matches')
        .insert({
          winner_team: winner,
          score,
          team_a_avg_elo: avgA,
          team_b_avg_elo: avgB,
          match_type: elo.matchType,
          elo_delta_winner: elo.winnerDelta,
          elo_delta_loser: elo.loserDelta,
        })
        .select()
        .single();

    if (matchError || !insertedMatch) {
      throw new Error(matchError?.message);
    }

    // UPDATE VINCITORI
    for (const player of winners) {
      const playerDelta =
        player.matches_played < 3
          ? 15
          : elo.winnerDelta;

      await supabase
        .from('padel_rankings')
        .update({
          current_elo:
            player.current_elo + playerDelta,

          matches_played:
            player.matches_played + 1,

          wins:
            player.wins + 1,
        })
        .eq('player_id', player.player_id);
    }

    // UPDATE PERDENTI
    for (const player of losers) {
      const playerDelta =
        player.matches_played < 3
          ? -15
          : elo.loserDelta;

      await supabase
        .from('padel_rankings')
        .update({
          current_elo:
            player.current_elo + playerDelta,

          matches_played:
            player.matches_played + 1,

          losses:
            player.losses + 1,
        })
        .eq('player_id', player.player_id);
    }

    // Storico vincitori
    for (const player of winners) {
      const playerDelta =
        player.matches_played < 3
          ? 15
          : elo.winnerDelta;

      await supabase
        .from('match_players')
        .insert({
          match_id: insertedMatch.id,

          player_id: player.player_id,

          team:
            winner === 'A'
              ? 'A'
              : 'B',

          elo_before: player.current_elo,

          elo_after:
            player.current_elo + playerDelta,

          delta: playerDelta,

          result: 'win',
        });
    }

    // Storico perdenti
    for (const player of losers) {
      const playerDelta =
        player.matches_played < 3
          ? -15
          : elo.loserDelta;

      await supabase
        .from('match_players')
        .insert({
          match_id: insertedMatch.id,

          player_id: player.player_id,

          team:
            winner === 'A'
              ? 'B'
              : 'A',

          elo_before: player.current_elo,

          elo_after:
            player.current_elo + playerDelta,

          delta: playerDelta,

          result: 'loss',
        });
    }

    return Astro.redirect('/admin/padel?saved=1');

  } catch (err: any) {
    console.log(err);
    throw err;
  }
}
---

<Layout title="Admin Padel">
  <datalist id="players-list">
    {players?.map(player => (
      <option value={player.players.name}></option>
    ))}
  </datalist>

  <section class="mb-8">
    <p class="text-sm uppercase tracking-widest font-black text-slate-600">
      Area riservata
    </p>

    <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
      Admin Padel
    </h1>

    <p class="mt-4 max-w-xl text-slate-700 font-medium">
      Inserisci un nuovo match ranking e aggiorna automaticamente la classifica ELO del torneo di Padel.
    </p>
  </section>

  {message && (
    <div
      id="success-banner"
      class="club-card bg-emerald-500 text-white p-4 mb-6 font-black"
    >
      {message}
    </div>
  )}

  <form
    method="POST"
    action="/admin/padel"
    class="club-card p-5 md:p-6 max-w-2xl space-y-8"
  >
    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-black text-white px-3 py-1 font-black text-sm">
          A
        </span>

        <h2 class="text-2xl font-black text-black">
          Team A
        </h2>
      </div>

      <div class="grid gap-3 md:grid-cols-2">
        <input
          type="text"
          name="a1_name"
          list="players-list"
          placeholder="Cerca giocatore A1..."
          required
          autocomplete="off"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />

        <input
          type="text"
          name="a2_name"
          list="players-list"
          placeholder="Cerca giocatore A2..."
          required
          autocomplete="off"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="h-1 bg-black flex-1"></div>

      <span class="bg-black text-white px-4 py-2 font-black uppercase text-sm">
        vs
      </span>

      <div class="h-1 bg-black flex-1"></div>
    </div>

    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-[var(--giallo-club)] border-2 border-black text-black px-3 py-1 font-black text-sm">
          B
        </span>

        <h2 class="text-2xl font-black text-black">
          Team B
        </h2>
      </div>

      <div class="grid gap-3 md:grid-cols-2">
        <input
          type="text"
          name="b1_name"
          list="players-list"
          placeholder="Cerca giocatore B1..."
          required
          autocomplete="off"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />

        <input
          type="text"
          name="b2_name"
          list="players-list"
          placeholder="Cerca giocatore B2..."
          required
          autocomplete="off"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-black mb-3 text-black">
          Vincitore
        </h2>

        <select
          name="winner"
          required
          class="w-full border-2 border-black bg-white p-3 font-bold"
        >
          <option value="A">Team A</option>
          <option value="B">Team B</option>
        </select>
      </div>

      <div>
        <h2 class="text-2xl font-black mb-3 text-black">
          Risultato
        </h2>

        <input
          type="text"
          name="score"
          placeholder="6-4 6-3"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />
      </div>
    </div>

    <button
      type="submit"
      class="club-btn w-full p-4 text-xl"
    >
      Salva Match Padel
    </button>
  </form>

  <script is:inline>
    const banner = document.getElementById('success-banner');

    if (banner) {
      setTimeout(() => {
        banner.remove();

        const url = new URL(window.location);

        url.searchParams.delete('saved');

        window.history.replaceState({}, '', url);
      }, 3000);
    }
  </script>
</Layout>
