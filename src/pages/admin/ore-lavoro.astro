---
import { getSupabaseAdmin } from "../../lib/supabaseAdmin";
import { isAdmin } from "../../lib/adminAuth";
import { caricaPeriodo, caricaStaff, isClub, isUuid } from "../../lib/ore-lavoro/server";
import { addGiorni, isIsoDate, lunediDi, oggiRoma, primoDelMese, ultimoDelMese } from "../../lib/time-grid";
import type { DatiPeriodo, Staff } from "../../lib/ore-lavoro/types";
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import OreLavoro from "../../components/ore-lavoro/OreLavoro.svelte";

if (!isAdmin(Astro.cookies)) {
    const redirectTo = encodeURIComponent(Astro.url.pathname);
    return Astro.redirect(`/login?redirect=${redirectTo}`);
}

const paramSettimana = Astro.url.searchParams.get("settimana");
const paramStaff = Astro.url.searchParams.get("staff");
const paramClub = Astro.url.searchParams.get("club");
const club = isClub(paramClub) ? paramClub : null;
const vista = Astro.url.searchParams.get("vista") === "mese" ? "mese" : "settimana";
const giornoParam = paramSettimana && isIsoDate(paramSettimana) ? paramSettimana : oggiRoma();
const lunedi = lunediDi(giornoParam);
const [dal, al] = vista === "mese" ? [primoDelMese(giornoParam), ultimoDelMese(giornoParam)] : [lunedi, addGiorni(lunedi, 6)];

let staff: Staff[] = [];
let dati: DatiPeriodo | null = null;
let errore = "";

try {
    const supabase = getSupabaseAdmin();
    staff = await caricaStaff(supabase);
    const selezionato =
        staff.find((s) => isUuid(paramStaff) && s.id === paramStaff) ?? staff.find((s) => s.sono_io) ?? staff[0];
    if (selezionato) {
        dati = await caricaPeriodo(supabase, selezionato.id, dal, al, {
            club,
            raggruppa: vista === "mese" ? "month" : "week",
        });
    }
} catch (err) {
    errore = err instanceof Error ? err.message : "Errore nel caricamento.";
}

const staffSelezionato = dati?.staff_id ?? staff[0]?.id ?? null;
---

<Layout title="Ore di lavoro" noindex={true} fullBleed>
    <div class="px-4 py-8">
        <section class="mb-8">
            <p class="text-sm uppercase tracking-widest font-black text-slate-600">
                Area riservata
            </p>

            <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
                Ore di lavoro
            </h1>

            <p class="mt-4 max-w-xl text-slate-700 font-medium">
                Ogni turno dell'orario settimanale conta come lavorato. Le eccezioni (assenze,
                sostituzioni, ore extra) cambiano il conteggio del giorno.
            </p>

            <div class="mt-6 flex flex-wrap gap-3">
                <a href="/admin" class="club-btn px-5 py-3">← Admin</a>
                <a href="/admin/ore-lavoro/kiosk" class="club-btn px-5 py-3" title="Solo la settimana, a tutto schermo (per il tablet)">Schermo tablet</a>
            </div>
        </section>

        <OreLavoro
            staffIniziale={staff}
            staffSelezionatoIniziale={staffSelezionato}
            settimanaIniziale={vista === "mese" ? dal : lunedi}
            vistaIniziale={vista}
            clubIniziale={club}
            datiIniziali={dati}
            erroreIniziale={errore}
            client:load
        />
    </div>
</Layout>
