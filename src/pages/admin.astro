---
import { supabase } from '../lib/supabase';
import { calculateEloChange } from '../lib/elo';
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';

const adminPassword = Astro.cookies.get('admin_password');

if (adminPassword?.value !== import.meta.env.ADMIN_PASSWORD) {
  return Astro.redirect('/login');
}

const { data: players } = await supabase
  .from('players')
  .select('*')
  .order('name');

let message = '';

if (Astro.url.searchParams.get('saved') === '1') {
  message = 'Match salvato correttamente!';
}

if (Astro.request.method === 'POST') {
  const body = await Astro.request.text();
  console.log('BODY:', body);

  const data = new URLSearchParams(body);

  const a1 = data.get('a1') || '';
  const a2 = data.get('a2') || '';
  const b1 = data.get('b1') || '';
  const b2 = data.get('b2') || '';
  const winner = (data.get('winner') || '') as 'A' | 'B';
  const score = data.get('score') || '';

  if (!a1 || !a2 || !b1 || !b2 || !winner) {
    throw new Error('Errore: alcuni campi del form non sono stati inviati.');
  }

  const ids = [a1, a2, b1, b2];

  if (new Set(ids).size !== 4) {
    throw new Error('Errore: hai selezionato due volte lo stesso giocatore.');
  }

  const { data: selectedPlayers, error } = await supabase
    .from('players')
    .select('*')
    .in('id', ids);

  if (error) {
    throw new Error(error.message);
  }

  if (!selectedPlayers || selectedPlayers.length !== 4) {
    throw new Error('Errore caricamento giocatori selezionati.');
  }

  const teamA = selectedPlayers.filter(p => p.id === a1 || p.id === a2);
  const teamB = selectedPlayers.filter(p => p.id === b1 || p.id === b2);

  const avgA = (teamA[0].current_elo + teamA[1].current_elo) / 2;
  const avgB = (teamB[0].current_elo + teamB[1].current_elo) / 2;

  // Calcolo Elo standard (usato come fallback per i veterani)
  const elo = calculateEloChange(avgA, avgB, winner);

  const winners = winner === 'A' ? teamA : teamB;
  const losers = winner === 'A' ? teamB : teamA;

  // 1. INSERIMENTO DEL MATCH NELLA TABELLA PRINCIPALE
  const { data: insertedMatch, error: matchError } = await supabase
    .from('matches')
    .insert({
      winner_team: winner,
      score,
      team_a_avg_elo: avgA,
      team_b_avg_elo: avgB,
      match_type: elo.matchType,
      elo_delta_winner: elo.winnerDelta, // <--- Ripristinato per il vincolo del DB
      elo_delta_loser: elo.loserDelta,   // <--- Ripristinato per il vincolo del DB
    })
    .select()
    .single();
  
  if (matchError) {
    throw new Error(matchError.message);
  }

  // 2. AGGIORNAMENTO CLASSIFICA VINCITORI (TABELLA PLAYERS)
  for (const player of winners) {
    const playerDelta = player.matches_played < 3 ? 15 : elo.winnerDelta;

    await supabase
      .from('players')
      .update({
        current_elo: player.current_elo + playerDelta,
        matches_played: player.matches_played + 1,
        wins: player.wins + 1,
      })
      .eq('id', player.id);
  }

  // 3. AGGIORNAMENTO CLASSIFICA PERDENTI (TABELLA PLAYERS)
  for (const player of losers) {
    const playerDelta = player.matches_played < 3 ? -15 : elo.loserDelta;

    await supabase
      .from('players')
      .update({
        current_elo: player.current_elo + playerDelta,
        matches_played: player.matches_played + 1,
        losses: player.losses + 1,
      })
      .eq('id', player.id);
  }

  // 4. INSERIMENTO STORICO INDIVIDUALE VINCITORI (TABELLA MATCH_PLAYERS)
  for (const player of winners) {
    const playerDelta = player.matches_played < 3 ? 15 : elo.winnerDelta;

    await supabase
      .from('match_players')
      .insert({
        match_id: insertedMatch.id,
        player_id: player.id,
        team: winner === 'A' ? (teamA.includes(player) ? 'A' : 'B') : (teamB.includes(player) ? 'B' : 'A'),
        elo_before: player.current_elo,
        elo_after: player.current_elo + playerDelta,
        delta: playerDelta,
        result: 'win',
      });
  }

  // 5. INSERIMENTO STORICO INDIVIDUALE PERDENTI (TABELLA MATCH_PLAYERS)
  for (const player of losers) {
    const playerDelta = player.matches_played < 3 ? -15 : elo.loserDelta;

    await supabase
      .from('match_players')
      .insert({
        match_id: insertedMatch.id,
        player_id: player.id,
        team: winner === 'A' ? (teamB.includes(player) ? 'B' : 'A') : (teamA.includes(player) ? 'A' : 'B'),
        elo_before: player.current_elo,
        elo_after: player.current_elo + playerDelta,
        delta: playerDelta,
        result: 'loss',
      });
  }

  return Astro.redirect('/admin?saved=1');
}
---

<Layout title="Admin">
  <section class="mb-8">
    <p class="text-sm uppercase tracking-widest font-black text-slate-600">
      Area riservata
    </p>

    <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
      Admin
    </h1>

    <p class="mt-4 max-w-xl text-slate-700 font-medium">
      Inserisci un nuovo match ranking e aggiorna automaticamente la classifica ELO.
    </p>
  </section>

  {message && (
    <div class="club-card bg-[var(--giallo-club)] p-4 mb-6 font-black">
      {message}
    </div>
  )}

  <form method="POST" action="/admin" class="club-card p-5 md:p-6 max-w-2xl space-y-8">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-black text-white px-3 py-1 font-black text-sm">
          A
        </span>
        <h2 class="text-2xl font-black text-black">
          Team A
        </h2>
      </div>

      <div class="grid gap-3 md:grid-cols-2">
        <select name="a1" required class="w-full border-2 border-black bg-white p-3 font-bold">
          {players?.map(player => (
            <option value={player.id}>{player.name}</option>
          ))}
        </select>

        <select name="a2" required class="w-full border-2 border-black bg-white p-3 font-bold">
          {players?.map(player => (
            <option value={player.id}>{player.name}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="h-1 bg-black flex-1"></div>
      <span class="bg-black text-white px-4 py-2 font-black uppercase text-sm">
        vs
      </span>
      <div class="h-1 bg-black flex-1"></div>
    </div>

    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="bg-[var(--giallo-club)] border-2 border-black text-black px-3 py-1 font-black text-sm">
          B
        </span>
        <h2 class="text-2xl font-black text-black">
          Team B
        </h2>
      </div>

      <div class="grid gap-3 md:grid-cols-2">
        <select name="b1" required class="w-full border-2 border-black bg-white p-3 font-bold">
          {players?.map(player => (
            <option value={player.id}>{player.name}</option>
          ))}
        </select>

        <select name="b2" required class="w-full border-2 border-black bg-white p-3 font-bold">
          {players?.map(player => (
            <option value={player.id}>{player.name}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-black mb-3 text-black">
          Vincitore
        </h2>

        <select name="winner" required class="w-full border-2 border-black bg-white p-3 font-bold">
          <option value="A">Team A</option>
          <option value="B">Team B</option>
        </select>
      </div>

      <div>
        <h2 class="text-2xl font-black mb-3 text-black">
          Risultato
        </h2>

        <input
          type="text"
          name="score"
          placeholder="6-4 6-3"
          class="w-full border-2 border-black bg-white p-3 font-bold"
        />
      </div>
    </div>

    <button type="submit" class="club-btn w-full p-4 text-xl">
      Salva Match
    </button>
  </form>
</Layout>