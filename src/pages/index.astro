const whatsappCommunityUrl =
    "https://chat.whatsapp.com/HOKXwefA8qDFQqpVwL4HwA";
---

<Layout
    title="Tie-Break Poggio San Vicino"
    image="/images/og/og-image.png"
    description="Tennis, padel, campionati e tornei a servizio della comunità a Poggio San Vicino. Scopri il circolo, le classifiche e il calendario delle competizioni."
>
    <a
        href={whatsappCommunityUrl}
        target="_blank"
        rel="noreferrer"
        class="club-btn-pastelgreen fixed bottom-8 left-4 right-4 z-50 inline-flex items-center justify-center gap-2 px-5 py-3 text-center md:left-auto md:right-6 md:w-auto"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="shrink-0" viewBox="0 0 16 16" aria-hidden="true">
