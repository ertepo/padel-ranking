---
import TournamentPage from '../../components/TournamentPage.astro';
import TournamentBracket from '../../components/TournamentBracket.astro';
import { fetchCloudinaryFolderImages } from '../../lib/cloudinary';

const formatTeam = (team = []) => team.filter(Boolean).join('\n');

// Cartella Cloudinary da cui pescare automaticamente le foto del torneo
// (dynamic asset folder, non il vecchio "public_id prefix").
const galleryImages = await fetchCloudinaryFolderImages(
  'tornei/cordivinbledon',
  'Cordivinbledon',
);

const resolveGroupMatches = (group) => ({
  ...group,
  matches: group.matches.map((match) => ({
    ...match,
    teamA: Number.isInteger(match.teamA)
      ? formatTeam(group.teams[match.teamA])
      : match.teamA,
    teamB: Number.isInteger(match.teamB)
      ? formatTeam(group.teams[match.teamB])
      : match.teamB,
    winner:
      String(match.winner) === String(match.teamA)
        ? 'A'
        : String(match.winner) === String(match.teamB)
          ? 'B'
          : match.winner,
  })),
});

