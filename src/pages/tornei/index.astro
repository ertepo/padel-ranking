---
import Layout from "../../layouts/Layout.astro";

const tornei = [
    {
        href: "/tornei/cascualian-open",
        img: "/images/tournaments/cascualian_open.svg",
        name: "Cascualian Open",
        winner: "Moreschini / Cirillo",
        accent: "dark-club-card-blue",
        highlight: "highlight-blue",
    },
    {
        href: "/tornei/serronchioland-garros",
        img: "/images/tournaments/serronchioland.svg",
        name: "Serronchioland Garros",
        winner: "Virgili / Nocelli",
        accent: "dark-club-card-green",
        highlight: "highlight-yellow",
    },
    {
        href: "/tornei/cordivinbledon",
        img: "/images/tournaments/cordivinbledon.svg",
        name: "Cordivimbledon",
        winner: "Moreschini / Cirillo",
        accent: "dark-club-card-violet",
        highlight: "highlight-violet",
    },
    {
        href: null,
        img: "/images/tournaments/palazzus.svg",
        name: "PalazzUS Open",
        winner: null,
        accent: "dark-club-card-yellow",
        highlight: "highlight-teal",
    },
];

const campionati = [
    {
        href: "/regolamento",
        title: "Vai al Regolamento",
        desc: "Regolamento campionati interni",
    },
    {
        href: "/ranking/tennis",
        title: "Classifica Tennis",
        desc: "Classifica aggiornata match dopo match.",
    },
    {
        href: "/ranking/padel",
        title: "Classifica Padel",
        desc: "Classifica aggiornata match dopo match.",
    },
    {
        href: "/matches",
        title: "Matches",
        desc: "Visualizza tutti gli incontri disputati.",
    },
    {
        href: "/tornei/gestione",
        title: "Organizza un torneo",
        desc: "Strumento per creare tabelloni e tornei americani del circolo.",
    },
];
---

<Layout
    title="Tornei & Campionati"
    description="Tutti i tornei di padel del Grande Slam estivo e i campionati individuali di tennis e padel del Tie-Break Poggio San Vicino: regolamento, classifiche e match."
>
    <section class="mb-14">
        <p class="text-sm uppercase tracking-widest font-black text-slate-600 mb-4">
            Estate in campo
        </p>

        <h1 class="text-4xl md:text-6xl font-black leading-none text-black">
            Tornei & Campionati
        </h1>

        <p class="mt-6 max-w-3xl text-lg md:text-xl font-bold leading-snug text-slate-700">
            Il Grande Slam estivo di padel e i due campionati individuali del
            circolo, con classifiche dedicate, sfide libere e playoff finali.
        </p>
    </section>

    <section class="mb-16">
        <h2 class="text-3xl md:text-4xl font-black leading-none text-black mb-6">
            Grande Slam estivo di padel
        </h2>

        <div class="grid grid-cols-2 gap-3 md:gap-5">
            {
                tornei.map((t) => {
                    const Tag = t.href ? "a" : "div";
                    return (
                        <Tag
                            href={t.href}
                            class={`dark-club-card ${t.accent} relative flex flex-col bg-white p-3 text-center transition md:p-4 ${t.href ? "hover:bg-[var(--giallo-club)]" : ""}`}
                        >
                            {t.winner && (
                                <div class="absolute inset-x-2 top-1.5 z-10 -rotate-2 border-2 border-dashed border-black bg-[var(--giallo-club)] px-1.5 py-0.5">
                                    <p class="flex flex-wrap items-center justify-center gap-x-1 text-[0.55rem] font-black uppercase leading-tight text-black md:text-2xl">
                                        <svg
                                        aria-hidden="true"
                            class="h-2 md:w-4 md:h-6 md:w-12 shrink-0 fill-current"
                            viewBox="0 0 402 321"
                            xmlns="http://www.w3.org/2000/svg">
                                            <path d="M162.187,29.82c1.031,-3.186 3.561,-14.872 17.753,-24.133c16.991,-11.088 53.249,-8.045 60.774,27.95c2.766,13.231 -4.423,30.921 -16.271,38.649c-4.39,2.864 -5.173,3.628 -2.868,8.364c0.159,0.327 0.146,0.303 1.975,4.093c0.66,1.358 1.321,2.716 1.981,4.074c34.227,68.182 34.076,68.28 34.863,69.072c2.748,2.767 3.514,0.873 37.312,-12.161c7.91,-3.051 7.745,-3.396 20.272,-8.222c2.34,-0.902 2.621,-0.391 4.294,-2.065c4.521,-4.522 -5.153,-7.94 2.331,-30.545c2.218,-4.734 3.702,-9.294 14.111,-17.692c6.499,-3.952 6.477,-4.024 13.803,-6.155c8.021,-1.268 8.785,-1.216 16.014,-0.423c5.014,1.096 16.532,2.555 27.479,18.526c0.72,1.293 1.441,2.586 2.161,3.879c0.473,1.125 4.839,9.028 3.53,21.935c-0.144,1.421 -1.126,13.893 -13.547,25.368c-2.99,2.085 -2.878,2.157 -5.83,4.237c-13.275,6.753 -15.101,5.019 -23.857,5.427c-1.558,0.073 -2.405,0.917 -2.466,0.94c-0.115,0.213 -1.147,0.042 -2.188,6.434c-1.079,6.627 -2.542,13.024 -8.178,48.661c-3.269,20.668 -7.14,39.23 -10.011,58.832c-1.729,11.806 -3.411,30.124 -23.622,41.205c-9.356,5.13 -17.686,4.346 -47.013,4.346c-161.456,-0 -161.46,0.064 -164.597,-0.511c-13.119,-2.404 -20.198,-9.819 -21.54,-11.224c-9.928,-10.398 -10.56,-21.804 -12.162,-31.839c-7.471,-47.354 -8.396,-47.177 -11.569,-68.715c-2.777,-18.849 -5.34,-31.737 -5.885,-34.481c-0.54,-2.715 -1.149,-12.236 -4.041,-13.324c-3.718,-1.399 -4.023,0.779 -15.661,-1.591c-3.017,-0.989 -2.986,-0.972 -5.939,-2.075c-5.686,-2.994 -9.509,-5.797 -13.65,-10.202c-0.173,-0.247 -13.843,-15.042 -8.849,-35.709c0.947,-3.919 2.654,-7.5 2.74,-7.723c2.414,-4.378 2.362,-4.391 5.423,-8.373c5.997,-6.787 11.239,-9.456 12.134,-10.015c0.733,-0.341 10.784,-6.411 26.179,-3.932c10.49,1.69 17.611,8.027 18.863,9.141c8.864,7.888 9.958,13.01 11.597,16.833c1.759,7.031 2.353,6.954 2.2,14.167c-0.169,7.989 -3.032,12.039 -0.489,14.592c1.396,1.401 1.665,0.991 22.799,9.602c12.229,4.983 12.33,4.628 24.541,9.755c0.278,0.117 0.26,0.102 3.507,1.378c0.816,0.322 1.608,0.7 2.423,1.022c0.471,0.186 4.888,1.929 6.037,1.905c0.841,-0.018 1.523,-0.336 1.646,-0.393c0.577,-0.269 0.348,-0.537 0.932,-0.809c3.858,-6.252 3.615,-7.225 8.35,-16.378c12.047,-23.286 20.132,-40.598 25.742,-51.038c1.043,-2.017 0.959,-2.031 2.016,-4.062c4.452,-9.049 5.371,-10.321 1.226,-13.262c-1.805,-1.281 -9.153,-4.932 -14.786,-17.509c-1.09,-2.434 -2.841,-8.499 -3.261,-11.793c-0.48,-3.761 0.296,-9.401 0.407,-10.211l0.863,-3.822Z" />
                                        </svg>
                                        {t.winner}
                                    </p>
                                </div>
                            )}

                            <img
                                src={t.img}
                                alt={t.name}
                                loading="lazy"
                                class:list={[
                                    "aspect-[16/9] w-full border-2 border-black bg-white object-contain p-2",
                                    t.winner && "pt-7",
                                ]}
                            />

                            <h3 class={`mt-2 text-sm font-black leading-tight text-black md:mt-3 md:text-lg ${t.highlight}`}>
                                {t.name}
                            </h3>

                            {!t.href && (
                                <p class="mt-1 text-[0.65rem] font-bold uppercase tracking-wide text-slate-500">
                                    Pagina in arrivo
                                </p>
                            )}
                        </Tag>
                    );
                })
            }
        </div>
    </section>

    <section class="mb-8">
        <h2 class="text-3xl md:text-4xl font-black leading-none text-black mb-2">
            Campionati interni
        </h2>

        <p class="max-w-3xl text-base md:text-lg font-semibold leading-relaxed text-slate-600 mb-6">
            Due campionati individuali, uno per il tennis e uno per il padel, con
            sistemi di punteggio dedicati e classifiche separate.
        </p>

        <div class="grid grid-cols-2 gap-3 md:gap-4">
            {
                campionati.map((c, i) => (
                    <a
                        href={c.href}
                        class:list={[
                            "club-card block min-w-0 bg-white p-4 transition hover:bg-[var(--giallo-club)] md:p-5",
                            [0, 3, 4].includes(i) && "col-span-2",
                        ]}
                    >
                        <h3 class="text-lg font-black leading-tight text-black md:text-xl md:leading-none">
                            {c.title}
                        </h3>
                        <p class="mt-2 text-sm font-bold text-slate-600">
                            {c.desc}
                        </p>
                    </a>
                ))
            }
        </div>
    </section>
</Layout>
