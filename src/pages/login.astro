---
import Layout from '../layouts/Layout.astro';

let error = '';

if (Astro.request.method === 'POST') {
  const body = await Astro.request.text();

  const data = new URLSearchParams(body);

  const password = data.get('password');

  if (
    password ===
    import.meta.env.ADMIN_PASSWORD
  ) {
    Astro.cookies.set(
      'admin_password',
      password,
      {
        path: '/',
        httpOnly: true,
      }
    );

    const redirectTo =
      Astro.url.searchParams.get('redirect') || '/admin';

    return Astro.redirect(redirectTo);
  }

  error = 'Password errata';
}
---

<Layout
  title="Login Admin"
  description="Accesso riservato all'area amministrativa Tie-Break Poggio San Vicino."
  noindex={true}
>
  <section class="mx-auto max-w-xl">
    <div class="mb-8">
      <p class="text-sm uppercase tracking-widest font-black text-slate-600 mb-3">
        Area riservata
      </p>

      <h1 class="text-5xl md:text-7xl font-black leading-none text-black">
        Admin Login
      </h1>
    </div>

    <article class="club-card bg-[var(--giallo-club)] p-5 md:p-6">
      <form method="POST" class="grid gap-5">
        <div>
          <label for="password" class="block text-xs uppercase tracking-widest font-black text-black opacity-60 mb-2">
            Password
          </label>

          <input
            id="password"
            type="password"
            name="password"
            placeholder="Inserisci password admin"
            class="w-full border-2 border-black bg-white p-4 text-xl font-black outline-none"
            required
          />
        </div>

        {error && (
          <p class="border-2 border-black bg-white p-3 font-black text-red-700">
            {error}
          </p>
        )}

        <button type="submit" class="club-btn w-full px-5 py-4 text-xl">
          Entra
        </button>
      </form>
    </article>
  </section>
</Layout>
