---
import Layout from '../layouts/Layout.astro';
import PhotoCarousel from './PhotoCarousel.svelte';

const { tournament } = Astro.props;
const registeredTeams = tournament.registrationDays.flatMap((day) => day.teams);
---

<Layout
  title={tournament.name}
  description={`${tournament.name}: squadre iscritte, gironi e risultati del torneo di padel Tie-Break Poggio San Vicino.`}
  image={tournament.ogImage || tournament.image}
  headerTheme="padel"
>
        
          {tournament.winnerBanner && (
            <section class="mb-12">
              <article class="club-card flex h-40 -rotate-2 items-center justify-center !bg-[var(--giallo-club)] p-6 text-center">
                <p class="flex flex-wrap items-center justify-center gap-4 text-4xl font-black uppercase leading-none text-black md:gap-6 md:text-6xl">
                  <svg
                    aria-hidden="true"
                    class="h-12 w-16 shrink-0 fill-current md:h-20 md:w-24"
                    viewBox="0 0 402 321"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M162.187,29.82c1.031,-3.186 3.561,-14.872 17.753,-24.133c16.991,-11.088 53.249,-8.045 60.774,27.95c2.766,13.231 -4.423,30.921 -16.271,38.649c-4.39,2.864 -5.173,3.628 -2.868,8.364c0.159,0.327 0.146,0.303 1.975,4.093c0.66,1.358 1.321,2.716 1.981,4.074c34.227,68.182 34.076,68.28 34.863,69.072c2.748,2.767 3.514,0.873 37.312,-12.161c7.91,-3.051 7.745,-3.396 20.272,-8.222c2.34,-0.902 2.621,-0.391 4.294,-2.065c4.521,-4.522 -5.153,-7.94 2.331,-30.545c2.218,-4.734 3.702,-9.294 14.111,-17.692c6.499,-3.952 6.477,-4.024 13.803,-6.155c8.021,-1.268 8.785,-1.216 16.014,-0.423c5.014,1.096 16.532,2.555 27.479,18.526c0.72,1.293 1.441,2.586 2.161,3.879c0.473,1.125 4.839,9.028 3.53,21.935c-0.144,1.421 -1.126,13.893 -13.547,25.368c-2.99,2.085 -2.878,2.157 -5.83,4.237c-13.275,6.753 -15.101,5.019 -23.857,5.427c-1.558,0.073 -2.405,0.917 -2.466,0.94c-0.115,0.213 -1.147,0.042 -2.188,6.434c-1.079,6.627 -2.542,13.024 -8.178,48.661c-3.269,20.668 -7.14,39.23 -10.011,58.832c-1.729,11.806 -3.411,30.124 -23.622,41.205c-9.356,5.13 -17.686,4.346 -47.013,4.346c-161.456,-0 -161.46,0.064 -164.597,-0.511c-13.119,-2.404 -20.198,-9.819 -21.54,-11.224c-9.928,-10.398 -10.56,-21.804 -12.162,-31.839c-7.471,-47.354 -8.396,-47.177 -11.569,-68.715c-2.777,-18.849 -5.34,-31.737 -5.885,-34.481c-0.54,-2.715 -1.149,-12.236 -4.041,-13.324c-3.718,-1.399 -4.023,0.779 -15.661,-1.591c-3.017,-0.989 -2.986,-0.972 -5.939,-2.075c-5.686,-2.994 -9.509,-5.797 -13.65,-10.202c-0.173,-0.247 -13.843,-15.042 -8.849,-35.709c0.947,-3.919 2.654,-7.5 2.74,-7.723c2.414,-4.378 2.362,-4.391 5.423,-8.373c5.997,-6.787 11.239,-9.456 12.134,-10.015c0.733,-0.341 10.784,-6.411 26.179,-3.932c10.49,1.69 17.611,8.027 18.863,9.141c8.864,7.888 9.958,13.01 11.597,16.833c1.759,7.031 2.353,6.954 2.2,14.167c-0.169,7.989 -3.032,12.039 -0.489,14.592c1.396,1.401 1.665,0.991 22.799,9.602c12.229,4.983 12.33,4.628 24.541,9.755c0.278,0.117 0.26,0.102 3.507,1.378c0.816,0.322 1.608,0.7 2.423,1.022c0.471,0.186 4.888,1.929 6.037,1.905c0.841,-0.018 1.523,-0.336 1.646,-0.393c0.577,-0.269 0.348,-0.537 0.932,-0.809c3.858,-6.252 3.615,-7.225 8.35,-16.378c12.047,-23.286 20.132,-40.598 25.742,-51.038c1.043,-2.017 0.959,-2.031 2.016,-4.062c4.452,-9.049 5.371,-10.321 1.226,-13.262c-1.805,-1.281 -9.153,-4.932 -14.786,-17.509c-1.09,-2.434 -2.841,-8.499 -3.261,-11.793c-0.48,-3.761 0.296,-9.401 0.407,-10.211l0.863,-3.822Z" />
                  </svg>
                  {tournament.winnerBanner}
                </p>
              </article>
            </section>
          )}
  <section class="mb-10">
    
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)] lg:items-end">
      <div>
        <p class="text-sm uppercase tracking-widest font-black text-slate-600 mb-4">
          Grande Slam estivo di padel
        </p>

        <h1 class="text-4xl md:text-7xl font-black leading-none text-black">
          {tournament.name}
        </h1>

        <p class="mt-5 text-2xl font-black text-[var(--blu-bilanciato)]">
          {tournament.date}
        </p>

        {tournament.description && (
          <p class="mt-5 max-w-2xl text-lg font-semibold leading-relaxed text-slate-700">
            {tournament.description}
          </p>
        )}
      </div>

      <div class="stamp">
        <img
          src={tournament.image}
          alt={tournament.name}
          class="aspect-[16/9] w-full bg-white object-contain p-5"
        />
      </div>
    </div>
  </section>

  <section class="mb-10">
    <div class="mb-5">
      <p class="text-sm uppercase tracking-widest font-black text-slate-600 mb-3">
        Iscrizioni
      </p>

      <h2 class="text-4xl md:text-5xl font-black leading-none text-black">
        Squadre iscritte
      </h2>
    </div>

    <article class="club-card p-5 bg-white">
      <ul class="grid gap-3 md:grid-cols-2">
        {registeredTeams.map((team) => (
          <li class="grid grid-cols-2 gap-3 border-2 border-black bg-white p-3 font-black text-lg">
            <span>{team[0]}</span>
            <span>{team[1]}</span>
          </li>
        ))}
      </ul>
    </article>
  </section>

  <section>
    <div class="mb-5">
      <p class="text-sm uppercase tracking-widest font-black text-slate-600 mb-3">
        Tabellone
      </p>

      <h2 class="text-4xl md:text-5xl font-black leading-none text-black">
        Gironi e risultati
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {tournament.groups.map((group) => (
        <article class="club-card p-5 !bg-gradient-to-br !from-blue-500 !to-red-500">
          <div class="flex items-center justify-between gap-4 border-b-2 border-black pb-4">
            <h3 class="text-3xl font-black leading-none text-black">
              {group.name}
            </h3>

            <span class="bg-[var(--giallo-club)] border-2 border-black px-3 py-1 text-xs font-black uppercase">
              {group.date}
            </span>
          </div>

          <div class="mt-5">
            <p class="text-xs uppercase tracking-widest font-black text-white mb-3">
              Squadre
            </p>

            <ul class="divide-y-2 divide-black border-2 border-black bg-white">
              {group.teams.map((team) => (
                <li class="grid grid-cols-2 gap-3 p-3 font-black">
                  <span>{team[0]}</span>
                  <span>{team[1]}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6">
            <p class="text-xs uppercase tracking-widest font-black text-white mb-3">
              Risultati
            </p>

            <ul class="space-y-3">
              {group.matches.map((match) => (
                <li class="border-2 border-black bg-slate-50 p-3">
                  <div class="grid md:grid-cols-[1fr_auto_1fr] md:items-center">
                    <p class={`font-black border-2 p-2 text-center md:whitespace-pre-line  ${match.winner === 'A' ? 'border-black bg-[var(--giallo-club)]' : ''}`}>
                      {match.teamA}
                    </p>

                    <p class="bg-black text-white px-3 py-2 text-center text-sm font-black uppercase">
                      {match.score || 'da giocare'}
                    </p>

                    <p class={`font-black border-2 p-2 text-center md:whitespace-pre-line ${match.winner === 'B' ? 'border-black bg-[var(--giallo-club)]' : ''}`}>
                      {match.teamB}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <slot />

  {tournament.gallery && tournament.gallery.length > 0 && (
    <section class="relative left-1/2 mt-16 w-screen -translate-x-1/2 border-y-2 border-black bg-black py-12 text-white">
      <div class="mx-auto max-w-5xl px-4">
        <div class="mb-8 max-w-3xl">
          <p class="text-sm uppercase tracking-widest font-black text-[var(--giallo-club)] mb-3">
            Foto del torneo
          </p>

          <h2 class="text-4xl md:text-5xl font-black leading-none text-white">
            {tournament.name}, momento per momento
          </h2>

          <p class="mt-5 text-lg font-bold leading-snug text-slate-300">
            Scorri con il dito per rivivere il torneo.
          </p>
        </div>

        <PhotoCarousel images={tournament.gallery} client:load />
      </div>
    </section>
  )}
</Layout>
