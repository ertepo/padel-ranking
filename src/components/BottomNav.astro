---
// Barra di navigazione fissa in basso, solo mobile (< lg). Sostituisce
// l'hamburger + drawer dell'header. Componente .astro puro: nessuna
// idratazione, legge il path corrente lato server per lo stato attivo.
const path = (Astro.url.pathname.replace(/\/+$/, "") || "/").toLowerCase();

const items = [
  {
    label: "Home",
    href: "/",
    icon: "home",
    active: path === "/",
  },
  {
    label: "Tornei",
    href: "/tornei",
    icon: "trophy",
    active:
      path === "/tornei" ||
      path.startsWith("/tornei/") ||
      path.startsWith("/ranking/") ||
      path === "/matches" ||
      path === "/regolamento",
  },
  {
    label: "Arcade",
    href: "/arcade",
    icon: "arcade",
    active: path === "/arcade" || path.startsWith("/arcade/"),
  },
  {
    label: "Prenota",
    href: "/prenotazioni",
    icon: "calendar",
    active: path.startsWith("/prenotazioni"),
  },
  {
    label: "Contatti",
    href: "/contatti",
    icon: "pin",
    active: path.startsWith("/contatti"),
  },
];
---

<nav
  aria-label="Navigazione principale"
  class="lg:hidden fixed inset-x-0 bottom-0 z-50 grid grid-cols-5 border-t-2 border-black bg-white"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  {
    items.map((item) => (
      <a
        href={item.href}
        aria-current={item.active ? "page" : undefined}
        class:list={[
          "flex min-h-14 flex-col items-center justify-center gap-1 px-1 py-2 text-center transition-colors",
          item.active
            ? "bg-[var(--giallo-club)] text-black"
            : "bg-white text-black hover:bg-slate-100",
        ]}
      >
        {item.icon === "home" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="currentColor"
            class="shrink-0"
            viewBox="0 -960 960 960"
            aria-hidden="true"
          >
            <path d="M240-200h120v-240h240v240h120v-360L480-740 240-560v360Zm-80 80v-480l320-240 320 240v480H520v-240h-80v240H160Zm320-350Z" />
          </svg>
        )}

        {item.icon === "trophy" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="currentColor"
            class="shrink-0"
            viewBox="0 -960 960 960"
            aria-hidden="true"
          >
            <path d="M280-120v-80h160v-124q-49-11-87.5-41.5T296-442q-75-9-125.5-65.5T120-640v-40q0-33 23.5-56.5T200-760h80v-80h400v80h80q33 0 56.5 23.5T840-680v40q0 76-50.5 132.5T664-442q-18 46-56.5 76.5T520-324v124h160v80H280Zm0-408v-152h-80v40q0 38 22 68.5t58 43.5Zm285 93q35-35 35-85v-240H360v240q0 50 35 85t85 35q50 0 85-35Zm115-93q36-13 58-43.5t22-68.5v-40h-80v152Zm-200-52Z" />
          </svg>
        )}

        {item.icon === "arcade" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="currentColor"
            class="shrink-0"
            viewBox="0 -960 960 960"
            aria-hidden="true"
          >
            <path d="M160-240q-33 0-56.5-23.5T80-320v-320q0-33 23.5-56.5T160-720h640q33 0 56.5 23.5T880-640v320q0 33-23.5 56.5T800-240H160Zm0-80h640v-320H160v320Zm120-40h80v-80h80v-80h-80v-80h-80v80h-80v80h80v80Zm342.5-17.5Q640-395 640-420t-17.5-42.5Q605-480 580-480t-42.5 17.5Q520-445 520-420t17.5 42.5Q555-360 580-360t42.5-17.5Zm120-120Q760-515 760-540t-17.5-42.5Q725-600 700-600t-42.5 17.5Q640-565 640-540t17.5 42.5Q675-480 700-480t42.5-17.5ZM160-320v-320 320Z" />
          </svg>
        )}

        {item.icon === "calendar" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.7"
            stroke="currentColor"
            width="22"
            height="22"
            class="shrink-0"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z"
            />
          </svg>
        )}

        {item.icon === "pin" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            fill="currentColor"
            class="shrink-0"
            viewBox="0 -960 960 960"
            aria-hidden="true"
          >
            <path d="M480-301q99-80 149.5-154T680-594q0-90-56-148t-144-58q-88 0-144 58t-56 148q0 65 50.5 139T480-301Zm0 101Q339-304 269.5-402T200-594q0-125 78-205.5T480-880q124 0 202 80.5T760-594q0 94-69.5 192T480-200Zm0-320q33 0 56.5-23.5T560-600q0-33-23.5-56.5T480-680q-33 0-56.5 23.5T400-600q0 33 23.5 56.5T480-520ZM200-80v-80h560v80H200Zm280-520Z" />
          </svg>
        )}

        <span class="text-[0.625rem] font-black uppercase leading-none tracking-wide">
          {item.label}
        </span>
      </a>
    ))
  }
</nav>
