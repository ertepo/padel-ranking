PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Cloud name non e un segreto: compare in chiaro negli URL delle immagini.
PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Server-only secrets: never prefix these with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=choose-a-strong-admin-password
LIVESCORE_CONTROL_TOKEN=generate-a-long-random-token

# Cloudinary Admin API, usata per pescare automaticamente le foto delle
# gallery dei tornei da una cartella (Settings > Access Keys nel Cloudinary Console).
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
